module dev.avinlang.tui

// A column of a table: its heading, its width in columns, and where its text sits: -1 left, 0
// centred, 1 right. A width of 0 makes it flexible: it takes a share of what the columns of fixed
// width leave, in proportion to its `flex` weight, after every flexible column has been given its
// `min`. A flexible column whose `min` there is no room for is left out, with the blank column before
// it; the columns after it are dropped first. A flexible column is never wider than `max`, where that
// is more than 0; what it would have taken past it goes to the other flexible columns, or is left
// blank at the right where every one of them is at its `max`.
//
// With `fit` the column is as wide as the widest of its heading (where the headings are drawn) and its
// cells in the rows drawn, held between `min`
// (at least 1) and `max` (where that is more than 0), and its `width` and `flex` are not used. A fit
// column gives way to the flexible columns: it is narrowed, down to its `min`, so that each of them
// still has `keep` columns or its `min`, whichever is more, and where that would take it under its
// `min` it is left out, with its blank column, the last fit column first. A fit column with no heading
// text and nothing in any of its cells is left out.
data Column(title: string, width: int, align: int = -1, min: int = 0, flex: int = 1, max: int = 0, fit: bool = false, keep: int = 0)

// A table of rows of text under a line of headings, one row selected, scrolled to keep the selected
// row in view. It keeps only the selection and the scroll: the rows are given to `draw` each frame,
// so the program owns its data and the table never holds a stale copy of it.
class Table(val columns: Vector[Column])
    // The selected row, counted from 0; -1 where there are no rows.
    var selected = 0
    // The first row shown.
    var offset = 0
    // The style of the headings, of the rows, and of the selected row.
    var headerStyle: Style = Style.plain().with(Bold | Reverse)
    var rowStyle: Style = Style.plain()
    var selectedStyle: Style = Style.plain().with(Reverse)

    // Moves the selection by `n` rows, held to the rows there are, `count` of them.
    moveBy(n: int, count: int)
        select(selected + n, count)

    // Selects row `i`, held to the rows there are.
    select(i: int, count: int)
        selected = if count <= 0 then -1 else if i < 0 then 0 else if i >= count then count - 1 else i

    // Whether the first row of the rectangle drawn in holds the headings.
    var header = true

    // The bar drawn down the right edge, beside the rows under the headings, while there are more rows
    // than fit; it takes its column from the table's width only then. `None`, the default, draws none.
    var scrollbar: Option[Scrollbar] = None

    // The widths the columns take in `width` columns, with one blank column between two; 0 for a
    // column left out. A fit column is measured against no rows, so it is left out.
    widths(width: int) -> Vector[int] = layout(width, Vector.fill(columns.length(), 0)).map(w -> maxOf(w, 0))

    // The widths the columns take in `width` columns with `rows` drawn in them, fit columns measured
    // against those rows; 0 for a column left out.
    widths(width: int, rows: Vector[Vector[Span]]) -> Vector[int] = layout(width, contentWidths(rows)).map(w -> maxOf(w, 0))

    // The widest of the heading (where the headings are drawn) and the cells of each fit column in `rows`.
    private contentWidths(rows: Vector[Vector[Span]]) -> Vector[int]
        val widest = Array.fill(columns.length(), 0)
        if header
            for j in 0 ..< columns.length()
                if columns(j).fit then widest(j) = textWidth(columns(j).title)
        for row in rows
            for j in 0 ..< minOf(row.length(), columns.length())
                if columns(j).fit then widest(j) = maxOf(widest(j), textWidth(row(j).text))
        widest.toVector()

    // The widths, -1 for a column left out: a flexible one for want of room for its `min`, a fit one
    // for want of room or of anything in it. `content` is the widest cell of each column.
    private layout(width: int, content: Vector[int]) -> Vector[int]
        val n = columns.length()
        if n == 0 then return Vector[int]()
        val shown = Array.fill(n, true)
        var fixed = 0
        for c in columns
            if !c.fit && c.width > 0 then fixed += c.width
        // The flexible columns are fitted first, as if no fit column were there.
        loop
            var active = 0
            var mins = 0
            var last = -1
            for j in 0 ..< n
                val c = columns(j)
                if shown(j) && !c.fit
                    active += 1
                    if c.width <= 0
                        mins += maxOf(c.min, 0)
                        if c.min > 0 then last = j
            if mins <= maxOf(width - fixed - (active - 1), 0) || last < 0 then break
            shown(last) = false
        // Then the fit columns, each its widest cell between its `min` and `max`, narrowed or left out,
        // the last first, until the flexible columns keep what they ask.
        val fitted = Array.fill(n, 0)
        for j in 0 ..< n
            val c = columns(j)
            if c.fit
                if content(j) <= 0 then shown(j) = false
                else fitted(j) = minOf(maxOf(content(j), fitMin(c)), cap(c))
        var j = n - 1
        while j >= 0
            if columns(j).fit && shown(j)
                val over = taken(shown, fitted, fixed) - width
                if over <= 0 then break
                if fitted(j) - over >= fitMin(columns(j)) then fitted(j) -= over
                else shown(j) = false
            j -= 1
        var count = 0
        var fitSum = 0
        for k in 0 ..< n
            if shown(k)
                count += 1
                if columns(k).fit then fitSum += fitted(k)
        val spare = maxOf(width - fixed - fitSum - (count - 1), 0)
        // What the minimums leave is shared by weight, the last weighted column taking what dividing
        // leaves over; a column whose share would take it past its `max` is held there and the rest
        // shared again among the others.
        var rest = spare
        for k in 0 ..< n
            if shown(k) && flexible(columns(k)) then rest -= maxOf(columns(k).min, 0)
        rest = maxOf(rest, 0)
        val held = Array.fill(n, false)
        val share = Array.fill(n, 0)
        loop
            var weights = 0
            for k in 0 ..< n
                if shown(k) && flexible(columns(k)) && !held(k) then weights += maxOf(columns(k).flex, 0)
            var seen = 0
            var given = 0
            for k in 0 ..< n
                val c = columns(k)
                if shown(k) && flexible(c) && !held(k)
                    val w = maxOf(c.flex, 0)
                    seen += w
                    share(k) = if weights == 0 || w == 0 then 0 else if seen == weights then rest - given else rest * w / weights
                    given += share(k)
            var again = false
            for k in 0 ..< n
                val c = columns(k)
                if shown(k) && flexible(c) && !held(k) && maxOf(c.min, 0) + share(k) > cap(c)
                    held(k) = true
                    share(k) = cap(c) - maxOf(c.min, 0)
                    rest -= share(k)
                    again = true
            if !again then break
        val out = Vector.newBuilder[int]()
        for k in 0 ..< n
            val c = columns(k)
            if !shown(k) then out.addOne(-1)
            else if c.fit then out.addOne(fitted(k))
            else if c.width > 0 then out.addOne(c.width)
            else out.addOne(maxOf(c.min, 0) + share(k))
        out.result()

    // The columns the shown ones take with the fit columns at `fitted` and each flexible column at
    // what it keeps, blanks between included.
    private taken(shown: Array[bool], fitted: Array[int], fixed: int) -> int
        var sum = fixed
        var count = 0
        for j in 0 ..< columns.length()
            if shown(j)
                count += 1
                val c = columns(j)
                if c.fit then sum += fitted(j)
                else if c.width <= 0 then sum += maxOf(maxOf(c.min, c.keep), 0)
        sum + maxOf(count - 1, 0)

    // Draws the headings on the first row of `r` and as many rows as fit under them, scrolling first
    // so the selected row is shown. A row with fewer cells than there are columns leaves the rest
    // blank; cells past the last column are not drawn.
    draw(g: Grid, r: Rect, rows: Vector[Vector[string]]) =
        drawSpans(g, r, rows.map(row -> row.map(t -> Span(t))))

    // Draws as `draw` does, each cell in its own style where it has one. On the selected row a cell
    // with its own style is drawn in it with the attributes of `selectedStyle` added, so the default
    // selection reverses the cell's own colours.
    drawSpans(g: Grid, r: Rect, rows: Vector[Vector[Span]])
        if r.isEmpty() then return
        val count = rows.length()
        select(selected, count)
        val top = if header then 1 else 0
        val visible = maxOf(r.h - top, 0)
        if selected >= 0
            if selected < offset then offset = selected
            if visible > 0 && selected >= offset + visible then offset = selected - visible + 1
        if offset > maxOf(count - visible, 0) then offset = maxOf(count - visible, 0)
        if offset < 0 then offset = 0
        val bar = if count > visible && visible > 0 && r.w >= 2 then scrollbar else None
        val body = bar match
            Some(_) -> Rect(r.x, r.y, r.w - 1, r.h)
            None -> r
        val ws = layout(body.w, contentWidths(rows))
        if header then line(g, r, r.y, columns.map(c -> Span(c.title)), ws, headerStyle, 0)
        for k in 0 ..< visible
            val i = offset + k
            val y = r.y + top + k
            if i >= count then g.fill(body.x, y, body.w, 1, rowStyle)
            else if i == selected then line(g, body, y, rows(i), ws, selectedStyle, selectedStyle.attrs)
            else line(g, body, y, rows(i), ws, rowStyle, 0)
        bar match
            Some(b) -> g.scrollbar(Rect(r.right() - 1, r.y + top, 1, visible), count, offset, visible, b)
            None -> ()

    // Draws one line of cells across `r` at row `y`, the cells with no style in `style` and those
    // with one in it with `attrs` added.
    private line(g: Grid, r: Rect, y: int, cells: Vector[Span], ws: Vector[int], style: Style, attrs: int)
        g.fill(r.x, y, r.w, 1, style)
        var x = r.x
        for j in 0 ..< columns.length()
            if ws(j) < 0 then continue
            val cell = if j < cells.length() then cells(j) else Span("")
            val s = cell.style match
                Some(own) -> own.with(attrs)
                None -> style
            g.textIn(x, y, ws(j), cell.text, s, columns(j).align, r)
            x += ws(j) + 1

// Whether `c` takes a share of the room the others leave.
private flexible(c: Column) -> bool = !c.fit && c.width <= 0

// The fewest columns a fit column is drawn in.
private fitMin(c: Column) -> int = maxOf(c.min, 1)

// The most columns `c` takes: its `max`, never under its `min`, or no limit.
private cap(c: Column) -> int = if c.max > 0 then maxOf(c.max, fitMin(c)) else int.MaxValue
