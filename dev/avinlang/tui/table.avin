module dev.avinlang.tui

// A column of a table: its heading, its width in columns, and where its text sits: -1 left, 0
// centred, 1 right. A width of 0 makes it flexible: it takes a share of what the columns of fixed
// width leave, in proportion to its `flex` weight, after every flexible column has been given its
// `min`. A flexible column whose `min` there is no room for is left out, with the blank column before
// it; the columns after it are dropped first.
data Column(title: string, width: int, align: int = -1, min: int = 0, flex: int = 1)

// A table of rows of text under a line of headings, one row selected, scrolled to keep the selected
// row in view. It keeps only the selection and the scroll: the rows are given to `draw` each frame,
// so the program owns its data and the table never holds a stale copy of it.
class Table(val columns: Vector[Column])
    // The selected row, counted from 0; -1 where there are no rows.
    var selected = 0
    // The first row shown.
    var offset = 0
    // The style of the headings, of the rows, and of the selected row.
    var headerStyle: Style = Style.plain().with(Bold | Reverse)
    var rowStyle: Style = Style.plain()
    var selectedStyle: Style = Style.plain().with(Reverse)

    // Moves the selection by `n` rows, held to the rows there are, `count` of them.
    moveBy(n: int, count: int)
        select(selected + n, count)

    // Selects row `i`, held to the rows there are.
    select(i: int, count: int)
        selected = if count <= 0 then -1 else if i < 0 then 0 else if i >= count then count - 1 else i

    // Whether the first row of the rectangle drawn in holds the headings.
    var header = true

    // The widths the columns take in `width` columns, with one blank column between two; 0 for a
    // column left out.
    widths(width: int) -> Vector[int] = layout(width).map(w -> maxOf(w, 0))

    // The widths, -1 for a flexible column left out for want of room for its `min`.
    private layout(width: int) -> Vector[int]
        val n = columns.length()
        if n == 0 then return Vector[int]()
        val shown = Array.fill(n, true)
        var fixed = 0
        for c in columns
            if c.width > 0 then fixed += c.width
        var spare = 0
        var weights = 0
        loop
            var active = 0
            var mins = 0
            weights = 0
            var last = -1
            for j in 0 ..< n
                if shown(j)
                    active += 1
                    val c = columns(j)
                    if c.width <= 0
                        mins += maxOf(c.min, 0)
                        weights += maxOf(c.flex, 0)
                        if c.min > 0 then last = j
            spare = maxOf(width - fixed - (active - 1), 0)
            if mins <= spare || last < 0 then break
            shown(last) = false
        // What the minimums leave is shared by weight, the last weighted column taking what dividing
        // leaves over.
        var rest = spare
        for j in 0 ..< n
            if shown(j) && columns(j).width <= 0 then rest -= maxOf(columns(j).min, 0)
        rest = maxOf(rest, 0)
        val out = Vector.newBuilder[int]()
        var seen = 0
        var given = 0
        for j in 0 ..< n
            val c = columns(j)
            if c.width > 0
                out.addOne(c.width)
            else if !shown(j)
                out.addOne(-1)
            else
                val w = maxOf(c.flex, 0)
                seen += w
                val share = if weights == 0 || w == 0 then 0 else if seen == weights then rest - given else rest * w / weights
                given += share
                out.addOne(maxOf(c.min, 0) + share)
        out.result()

    // Draws the headings on the first row of `r` and as many rows as fit under them, scrolling first
    // so the selected row is shown. A row with fewer cells than there are columns leaves the rest
    // blank; cells past the last column are not drawn.
    draw(g: Grid, r: Rect, rows: Vector[Vector[string]]) =
        drawSpans(g, r, rows.map(row -> row.map(t -> Span(t))))

    // Draws as `draw` does, each cell in its own style where it has one. On the selected row a cell
    // with its own style is drawn in it with the attributes of `selectedStyle` added, so the default
    // selection reverses the cell's own colours.
    drawSpans(g: Grid, r: Rect, rows: Vector[Vector[Span]])
        if r.isEmpty() then return
        val count = rows.length()
        select(selected, count)
        val top = if header then 1 else 0
        val visible = maxOf(r.h - top, 0)
        if selected >= 0
            if selected < offset then offset = selected
            if visible > 0 && selected >= offset + visible then offset = selected - visible + 1
        if offset > maxOf(count - visible, 0) then offset = maxOf(count - visible, 0)
        if offset < 0 then offset = 0
        val ws = layout(r.w)
        if header then line(g, r, r.y, columns.map(c -> Span(c.title)), ws, headerStyle, 0)
        for k in 0 ..< visible
            val i = offset + k
            val y = r.y + top + k
            if i >= count then g.fill(r.x, y, r.w, 1, rowStyle)
            else if i == selected then line(g, r, y, rows(i), ws, selectedStyle, selectedStyle.attrs)
            else line(g, r, y, rows(i), ws, rowStyle, 0)

    // Draws one line of cells across `r` at row `y`, the cells with no style in `style` and those
    // with one in it with `attrs` added.
    private line(g: Grid, r: Rect, y: int, cells: Vector[Span], ws: Vector[int], style: Style, attrs: int)
        g.fill(r.x, y, r.w, 1, style)
        var x = r.x
        for j in 0 ..< columns.length()
            if ws(j) < 0 then continue
            val cell = if j < cells.length() then cells(j) else Span("")
            val s = cell.style match
                Some(own) -> own.with(attrs)
                None -> style
            g.textIn(x, y, ws(j), cell.text, s, columns(j).align, r)
            x += ws(j) + 1
