module dev.avinlang.tui

// One part of a gauge: how much of the budget it takes, and the character and style its cells are
// drawn in.
data Segment(amount: real, style: Style, ch: char = '█')

// The cells each segment fills out of `width`, for `segments` laid end to end against `budget`.
//
// Each boundary is placed at the nearest cell to where the segments up to it end, an exact half
// rounding up, so the cells add up as the amounts do and no rounding is lost or counted twice; what
// passes the budget is cut off at the end. A negative amount, or one that is not a number, takes no
// cells; so does everything when the budget is 0 or less.
gaugeCells(width: int, segments: Vector[Segment], budget: real) -> Vector[int] =
  steps(boundaries(maxOf(width, 0), segments, budget))

// The eighths of a cell each segment fills out of `width` cells, placed as `gaugeCells` places whole
// cells: each boundary at the nearest eighth to where the segments up to it end.
gaugeEighths(width: int, segments: Vector[Segment], budget: real) -> Vector[int] =
  steps(boundaries(maxOf(width, 0) * 8, segments, budget))

// The cells each segment fills out of `width` in a gauge drawn with `bars`: placed as `gaugeCells`
// places them, except that a segment of more than nothing whose boundary rounds onto the one before
// it still takes one cell, as long as the whole gauge fills at least one cell and there is a cell
// left. The cell comes from the next segment where that one has cells to spare, and otherwise moves
// the boundaries after it on by one; no gauge takes more than `width`. So a segment too small for
// half a cell still shows, where `gaugeCells` would leave it out.
gaugeBars(width: int, segments: Vector[Segment], budget: real) -> Vector[int]
  val units = maxOf(width, 0)
  val ends = boundaries(units, segments, budget)
  if ends.isEmpty || ends(ends.length - 1) == 0 then return steps(ends)
  val out = Vector.newBuilder[int]()
  var before = 0
  for (s, e) in segments.zip(ends)
    var end = maxOf(e, before)
    if s.amount > 0.0 && end == before && before < units then end = before + 1
    out.addOne(end)
    before = end
  steps(out.result())

// Where each segment ends, out of `units`, counted from the start.
private boundaries(units: int, segments: Vector[Segment], budget: real) -> Vector[int]
  val out = Vector.newBuilder[int]()
  var sum = 0.0
  for s in segments
    if s.amount > 0.0 then sum += s.amount
    out.addOne(unitsAt(sum, budget, units))
  out.result()

// The differences between one boundary and the one before it, the first counted from 0.
private steps(ends: Vector[int]) -> Vector[int]
  val out = Vector.newBuilder[int]()
  var before = 0
  for e in ends
    out.addOne(e - before)
    before = e
  out.result()

// The nearest of `units` to `sum` out of `budget`, held to the units there are. The product is taken
// before the quotient, so an amount that falls on an exact half of a unit is not pushed under it by
// the rounding of `sum / budget`.
private unitsAt(sum: real, budget: real, units: int) -> int
  if budget.isNaN || budget <= 0.0 || sum <= 0.0 then return 0
  if sum >= budget then return units
  int(sum * real(units) / budget + 0.5)

// The blocks a partly filled cell of a gauge is drawn with, an eighth of a cell more each.
private val gaugeBlocks: string = " ▏▎▍▌▋▊▉█"

impl Grid
  // Draws a gauge from column `x` of row `y`, `width` columns in all: the segments one after another,
  // each as many cells as its share of `budget` (see `gaugeCells`), the cells after them `rest` in
  // `empty`. With `brackets` the gauge is drawn between `[` and `]` in `frame`, which take two of its
  // columns; a gauge under three columns wide gets none. A character not one column wide, for a
  // segment or for `rest`, is drawn as `█` or `·`, so every cell of the gauge is one column. Answers
  // the column after it.
  //
  // With `eighths` the segments are placed in eighths of a cell (see `gaugeEighths`). Each cell is
  // drawn by the segment its left edge falls in: whole in the segment's character where the segment
  // covers all of it, and otherwise as a left block of the eighths it covers (`▏` to `▉`) in the
  // segment's colour. The block's background is the colour of the segment that follows, so a cell
  // shared by two segments shows both and never a black remainder; after the last segment it is
  // `empty`'s background, as `meter` draws its last cell. A segment of no eighths draws nothing. A
  // segment that begins inside a cell shows from the next one, so a segment drawn over the start of
  // another is two segments end to end: the inner one, then the rest of the outer.
  //
  // With `bars` the gauge is drawn as htop draws its meters: every cell a segment covers is a `|` in
  // the segment's style, whatever its character, and the cells after them are blank in `empty`. The
  // cells are shared out by `gaugeBars`, so a segment of more than nothing shows as at least one
  // cell. `bars` is drawn in whole cells; `eighths` is not used with it.
  //
  // A `label` is written inside the gauge, its right end against the last cell before `]`, over the
  // cells it covers: each of its characters takes the style of the cell it replaces, a segment's
  // where the bar is filled and `empty` where it is not. A label wider than the gauge's inside is cut
  // at its end to fit; a two-column character that would not fit whole is left out.
  gauge(
      x: int,
      y: int,
      width: int,
      segments: Vector[Segment],
      budget: real,
      empty: Style = Style.fg(BrightBlack),
      rest: char = '·',
      brackets: bool = true,
      frame: Style = Style.plain(),
      clip: Rect = Rect(0, 0, int.MaxValue, int.MaxValue),
      eighths: bool = false,
      bars: bool = false,
      label: string = ""
  ) -> int
    if width <= 0 then return x
    val c = clip.intersect(area())
    val framed = brackets && width >= 3
    val inner = if framed then width - 2 else width
    val left = if framed then x + 1 else x
    if framed
      cell(x, y, '[', frame, c)
      cell(x + width - 1, y, ']', frame, c)
    val restCh = oneColumn(rest, '·')
    if bars
      var col = left
      for (s, n) in segments.zip(gaugeBars(inner, segments, budget))
        for _ in 0 ..< n
          cell(col, y, '|', s.style, c)
          col += 1
      while col < left + inner
        cell(col, y, ' ', empty, c)
        col += 1
    else if eighths
      val ends = boundaries(inner * 8, segments, budget)
      var j = 0
      for i in 0 ..< inner
        val start = i * 8
        while j < ends.length && ends(j) <= start
          j += 1
        if j == ends.length
          cell(left + i, y, restCh, empty, c)
        else
          val s = segments(j)
          val covered = ends(j) - start
          if covered >= 8 then cell(left + i, y, oneColumn(s.ch, '█'), s.style, c)
          else
            var k = j + 1
            while k < ends.length && ends(k) <= ends(j)
              k += 1
            val behind = if k < ends.length then segments(k).style.fg else empty.bg
            cell(left + i, y, gaugeBlocks.chars(covered), Style(s.style.fg, behind, s.style.attrs), c)
    else
      var col = left
      for (s, n) in segments.zip(gaugeCells(inner, segments, budget))
        val ch = oneColumn(s.ch, '█')
        for _ in 0 ..< n
          cell(col, y, ch, s.style, c)
          col += 1
      while col < left + inner
        cell(col, y, restCh, empty, c)
        col += 1
    if label != "" then gaugeLabel(left, y, inner, label, c)
    x + width

  // Writes `label` right-aligned in the `inner` cells from column `left` of row `y`, each cluster in
  // the style of the cell it lands on, as `gauge` describes.
  private gaugeLabel(left: int, y: int, inner: int, label: string, c: Rect)
    val shown = Vector.newBuilder[Cluster]()
    var w = 0
    for cl in clusters(label)
      if w + cl.width > inner then break
      shown.addOne(cl)
      w += cl.width
    var col = left + inner - w
    for cl in shown.result()
      if c.contains(col, y) && (cl.width < 2 || c.contains(col + 1, y))
        put(col, y, cl, apply(col, y).style)
      col += cl.width

// `ch` where it is one column wide and not a control character, and `instead` where it is not.
private oneColumn(ch: char, instead: char) -> char = if charWidth(ch) == 1 && !ch.isControl then ch else instead
