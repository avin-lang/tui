module tests

// The table's rows: sorting, filtering, the tree, and the text of each cell.
import dev.avinlang.top.{ByCpu, ByMem, ByPid, ByTime, Row, bytes, cells, clock, filterRows, kib, sortRows,
                         sortTitle, treeRows, uptime}

row(pid: long, cpu: real = 0.0, ppid: long = 1, command: string = "cmd", rss: long = 1000, time: long = 0) -> Row =
    Row(proc(pid, ppid, command, time, time, rss), cpu, "")

// The rows' pids, in order, separated by blanks.
pids(rows: Vector[Row]) -> string = rows.map(r -> r.proc.pid).mkString(" ")

@test("by CPU% the busiest first, equal ones by pid")
sortCpu()
    val rows = [row(3, 1.0), row(1, 5.0), row(2, 1.0), row(4, 0.0)]
    assertEq(pids(sortRows(rows, ByCpu)), "1 2 3 4")

@test("by MEM% the largest resident memory first")
sortMem()
    val rows = [row(1, rss = 10), row(2, rss = 300), row(3, rss = 20), row(4, rss = 300)]
    assertEq(pids(sortRows(rows, ByMem)), "2 4 3 1")

@test("by TIME the most processor time first")
sortTime()
    val rows = [row(1, time = 5), row(2, time = 500), row(3, time = 50)]
    assertEq(pids(sortRows(rows, ByTime)), "2 3 1")

@test("by PID the smallest first")
sortPid()
    assertEq(pids(sortRows([row(30), row(4), row(1000), row(1)], ByPid)), "1 4 30 1000")

@test("sorting nothing or one row")
sortSmall()
    assertEq(sortRows([], ByCpu).length(), 0)
    assertEq(pids(sortRows([row(9)], ByMem)), "9")

@test("each sort names its column")
sortTitles()
    assertEq([ByCpu, ByMem, ByTime, ByPid].map(sortTitle), ["CPU%", "MEM%", "TIME+", "PID"])

@test("the filter keeps commands holding its text, letter case aside")
filter()
    val rows = [row(1, command = "/usr/bin/Safari"), row(2, command = "zsh"), row(3, command = "safaridriver")]
    assertEq(pids(filterRows(rows, "safari")), "1 3")
    assertEq(pids(filterRows(rows, "SAFARI")), "1 3")
    assertEq(pids(filterRows(rows, "")), "1 2 3")
    assertEq(pids(filterRows(rows, "nothing")), "")
    assertEq(pids(filterRows(rows, "/")), "1")

@test("the filter matches text beyond ASCII and spaces")
filterUnicode()
    val rows = [row(1, command = "Grüße App"), row(2, command = "日本語 tool"), row(3, command = "plain")]
    assertEq(pids(filterRows(rows, "grüße")), "1")
    assertEq(pids(filterRows(rows, "日本")), "2")
    assertEq(pids(filterRows(rows, "e a")), "1")

@test("the tree puts each process under its parent, siblings in the order given, with branches drawn")
tree()
    val rows = [row(1, ppid = 0, command = "launchd"), row(10, ppid = 1, command = "a"), row(11, ppid = 10, command = "a1"),
                row(12, ppid = 10, command = "a2"), row(20, ppid = 1, command = "b"), row(21, ppid = 20, command = "b1")]
    val t = treeRows(rows)
    assertEq(pids(t), "1 10 11 12 20 21")
    assertEq(t.map(r -> r.branch + r.proc.command),
             ["launchd", "├─ a", "│  ├─ a1", "│  └─ a2", "└─ b", "   └─ b1"])

@test("the tree keeps the order of the rows it is given among siblings")
treeOrder()
    val rows = [row(1, ppid = 0), row(3, ppid = 1), row(2, ppid = 1)]
    assertEq(pids(treeRows(rows)), "1 3 2")

@test("a process whose parent is not shown is a root, so a filtered tree keeps what matches")
treeOrphans()
    val rows = [row(5, ppid = 99), row(6, ppid = 5), row(7, ppid = 98)]
    val t = treeRows(rows)
    assertEq(pids(t), "5 6 7")
    assertEq(t.map(r -> r.branch), ["", "└─ ", ""])

@test("a process that is its own parent, and a loop of parents, appear once each")
treeLoops()
    assertEq(pids(treeRows([row(0, ppid = 0), row(1, ppid = 0)])), "0 1")
    // 1 and 2 are each other's parent: neither is a root, so they come after the roots, once each.
    val circle = treeRows([row(1, ppid = 2), row(2, ppid = 1), row(3, ppid = 0)])
    assertEq(pids(circle), "3 1 2")

@test("the tree of no rows is empty, and a deep chain is indented step by step")
treeDeep()
    assertEq(treeRows([]).length(), 0)
    val chain = Vector.tabulate(200, i -> row(long(i + 1), ppid = long(i)))
    val t = treeRows(chain)
    assertEq(t.length(), 200)
    assertEq(t(199).branch, "   ".repeat(198) + "└─ ")

@test("a row's cells")
rowCells()
    val r = Row(proc(4242, user = 0, cpu = 12345, rss = 204800, command = "/bin/zsh"), 12.345, "└─ ")
    assertEq(cells(r), ["4242", "ed", "12.3", "20.5", "200M", "2:03.45", "└─ /bin/zsh"])

@test("resident memory: KiB, then MiB, then GiB")
kibs()
    assertEq(kib(0), "0")
    assertEq(kib(99999), "99999")
    assertEq(kib(100000), "97M")
    assertEq(kib(10239999), "9999M")
    assertEq(kib(10240000), "9.8G")
    assertEq(kib(long(64) * 1048576), "64.0G")

@test("sizes in the largest unit leaving at least one")
byteSizes()
    assertEq(bytes(0), "0B")
    assertEq(bytes(1023), "1023B")
    assertEq(bytes(1024), "1.0K")
    assertEq(bytes(1048576), "1.0M")
    assertEq(bytes(1073741824), "1.0G")
    assertEq(bytes(long(64) * 1073741824), "64.0G")

@test("processor time: m:ss.hh under an hour, h:mm:ss from there")
clocks()
    assertEq(clock(0), "0:00.00")
    assertEq(clock(47), "0:00.47")
    assertEq(clock(6000), "1:00.00")
    assertEq(clock(359999), "59:59.99")
    assertEq(clock(360000), "1h00:00")
    assertEq(clock(long(101) * 360000 + 6100), "101h01:01")

@test("uptime: hours, minutes and seconds, and days when there are any")
uptimes()
    assertEq(uptime(0), "00:00:00")
    assertEq(uptime(3661), "01:01:01")
    assertEq(uptime(86399), "23:59:59")
    assertEq(uptime(86400), "1 day, 00:00:00")
    assertEq(uptime(90061), "1 day, 01:01:01")
    assertEq(uptime(long(400) * 86400), "400 days, 00:00:00")
    assertEq(uptime(-5), "00:00:00")
