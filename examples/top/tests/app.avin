module tests

// The keys: sorting, moving, the filter, the tree, help, a kill's question, and quitting.
import dev.avinlang.top.{App, ByCpu, ByMem, ByPid, ByTime, Kill, Quit, Sample, Stay, Usage, usage}
import dev.avinlang.tui.{Backspace, Char, Ctrl, Down, End, Enter, Escape, Event, F, Home, KeyPress, Mouse,
                         MouseEvent, PageDown, PageUp, Paste, Resize, ScrollDown, ScrollUp, Stop, Up}

key(c: char) -> Event = KeyPress(Char(c), 0)

// Five processes, by CPU% 5 4 3 2 1 for pids 1 to 5, with commands a to e.
five() -> (Sample, Usage)
    val procs = Vector.tabulate(5, i -> proc(long(i + 1), command = ["a", "b", "c", "d", "e"](i), percent = real(5 - i),
                                             rss = long(100 * (i + 1)), cpu = long(10 * ((i + 3) % 5))))
    val s = sample(0, procs)
    (s, usage(None, s))

app() -> App
    val a = App("tests")
    val (s, u) = five()
    a.update(s, u)
    a

shownPids(a: App) -> string = a.shown.map(r -> r.proc.pid).mkString(" ")

selectedPid(a: App) -> long = a.selected().get.pid

@test("rows are sorted by CPU% at first, and P M T N sort by each column")
sortKeys()
    val a = app()
    val (s, u) = five()
    assertEq(shownPids(a), "1 2 3 4 5")
    for (c, k, order) in [('M', ByMem, "5 4 3 2 1"), ('T', ByTime, "2 1 5 4 3"), ('N', ByPid, "1 2 3 4 5"), ('P', ByCpu, "1 2 3 4 5")]
        assertEq(a.handle(key(c)), Stay)
        assertEq(a.sortKey, k)
        a.update(s, u)
        assertEq(shownPids(a), order)

@test("the arrows, page keys, Home and End move the selection, held to the rows")
moving()
    val a = app()
    assertEq(selectedPid(a), 1)
    a.handle(KeyPress(Down, 0))
    assertEq(selectedPid(a), 2)
    a.handle(KeyPress(Up, 0))
    a.handle(KeyPress(Up, 0))
    assertEq(selectedPid(a), 1)
    a.handle(KeyPress(End, 0))
    assertEq(selectedPid(a), 5)
    a.handle(KeyPress(Down, 0))
    assertEq(selectedPid(a), 5)
    a.handle(KeyPress(Home, 0))
    assertEq(selectedPid(a), 1)
    a.page = 3
    a.handle(KeyPress(PageDown, 0))
    assertEq(selectedPid(a), 4)
    a.handle(KeyPress(PageDown, 0))
    assertEq(selectedPid(a), 5)
    a.handle(KeyPress(PageUp, 0))
    assertEq(selectedPid(a), 2)

@test("the mouse wheel moves the selection three rows")
wheel()
    val a = app()
    a.handle(Mouse(MouseEvent(ScrollDown, 0, 0, 0, 0)))
    assertEq(selectedPid(a), 4)
    a.handle(Mouse(MouseEvent(ScrollUp, 0, 0, 0, 0)))
    assertEq(selectedPid(a), 1)

@test("the selection follows its process when the order changes")
followsProcess()
    val a = app()
    val (s, u) = five()
    a.handle(KeyPress(Down, 0))
    assertEq(selectedPid(a), 2)
    a.handle(key('M'))
    a.update(s, u)
    assertEq(selectedPid(a), 2)
    assertEq(a.table.selected, 3)

@test("when the selected process is gone the selection stays where it was, held to the rows")
selectedGone()
    val a = app()
    a.handle(KeyPress(End, 0))
    val (s, u) = five()
    val fewer = sample(1, s.procs.take(3))
    a.update(fewer, usage(None, fewer))
    assertEq(selectedPid(a), 3)
    val none = sample(2, [])
    a.update(none, usage(None, none))
    assertEq(a.selected(), None)

@test("/ starts the filter; typed text narrows the rows, Backspace takes back, Enter keeps it")
filterTyping()
    val a = app()
    val (s, u) = five()
    a.handle(key('/'))
    assert(a.editingFilter)
    // Keys that mean something elsewhere are text here.
    a.handle(key('q'))
    a.handle(key('c'))
    assertEq(a.filter, "qc")
    a.update(s, u)
    assertEq(shownPids(a), "")
    a.handle(KeyPress(Backspace, 0))
    a.handle(KeyPress(Backspace, 0))
    a.handle(KeyPress(Backspace, 0))
    assertEq(a.filter, "")
    a.handle(key('C'))
    a.update(s, u)
    assertEq(shownPids(a), "3")
    a.handle(KeyPress(Enter, 0))
    assert(!a.editingFilter)
    assertEq(a.filter, "C")
    a.update(s, u)
    assertEq(shownPids(a), "3")

@test("Escape clears the filter; a paste goes into it; F3 starts it too")
filterEscapePaste()
    val a = app()
    a.handle(KeyPress(F(3), 0))
    a.handle(Paste("ab"))
    assertEq(a.filter, "ab")
    a.handle(KeyPress(Escape, 0))
    assertEq(a.filter, "")
    assert(!a.editingFilter)

@test("while filtering, F10 and a stop signal still quit")
filterQuit()
    val a = app()
    a.handle(key('/'))
    assertEq(a.handle(KeyPress(F(10), 0)), Quit)
    a.handle(key('/'))
    assertEq(a.handle(Stop(15)), Quit)

@test("t and F5 turn the tree on and off")
treeToggle()
    val a = app()
    a.handle(key('t'))
    assert(a.tree)
    a.handle(KeyPress(F(5), 0))
    assert(!a.tree)

@test("k and F9 ask before sending TERM to the selected process; y sends it")
killYes()
    val a = app()
    a.handle(KeyPress(Down, 0))
    assertEq(a.handle(key('k')), Stay)
    assertEq(a.confirming.map(p -> p.pid), Some(long(2)))
    assertEq(a.handle(key('y')), Kill(2))
    assertEq(a.confirming, None)
    a.handle(KeyPress(F(9), 0))
    assertEq(a.handle(key('Y')), Kill(2))

@test("any other answer sends nothing, and says so")
killNo()
    val a = app()
    a.handle(key('k'))
    assertEq(a.handle(key('n')), Stay)
    assertEq(a.message, "not sent")
    a.handle(key('k'))
    assertEq(a.handle(key('q')), Stay)
    assertEq(a.confirming, None)

@test("asking to kill with no process selected asks nothing")
killNothing()
    val a = App("tests")
    val s = sample(0, [])
    a.update(s, usage(None, s))
    a.handle(key('k'))
    assertEq(a.confirming, None)
    assertEq(a.message, "no process selected")

@test("q, F10, Ctrl-C and a stop signal quit; other Ctrl keys do nothing")
quitting()
    val a = app()
    assertEq(a.handle(key('q')), Quit)
    assertEq(a.handle(KeyPress(F(10), 0)), Quit)
    assertEq(a.handle(KeyPress(Char('c'), Ctrl)), Quit)
    assertEq(a.handle(Stop(1)), Quit)
    assertEq(a.handle(KeyPress(Char('q'), Ctrl)), Stay)
    assertEq(a.handle(Resize(80, 24)), Stay)

@test("h, ?, and F1 open the help; the next key closes it and does nothing else")
help()
    val a = app()
    for e in [key('h'), key('?'), KeyPress(F(1), 0)]
        a.handle(e)
        assert(a.help)
        assertEq(a.handle(key('q')), Stay)
        assert(!a.help)
    a.handle(key('h'))
    assertEq(a.handle(Stop(15)), Quit)

@test("a key clears the last message")
messageCleared()
    val a = app()
    a.message = "sent TERM to 2"
    a.handle(KeyPress(Down, 0))
    assertEq(a.message, "")
