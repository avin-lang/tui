module tests

// The diff renderer, byte for byte: what the first frame, an unchanged frame and a changed one write;
// cursor movement; styles in each colour mode; two-column characters; resizing.
import tui
import tui.{Basic, Bold, Cluster, Default, Dim, Grid, Indexed, Italic, Renderer, Reverse, Rgb, Style,
            Underline, cursorMove, sgr}
import tui.{Basic16, Palette256, TrueColor}

val E: string = "\u{1b}["
val Clear: string = "\u{1b}[0m\u{1b}[H\u{1b}[2J"

// A grid of `w` by `h` with `text` written along row `y` from column `x`, in `style`.
grid(w: int, h: int) -> Grid = Grid(w, h)

write(g: Grid, x: int, y: int, text: string, style: Style = Style.plain()) -> Grid
    var col = x
    for c in tui.clusters(text)
        col += g.put(col, y, c, style)
    g

// The renderer after drawing `first`, with what that frame wrote set aside.
after(first: Grid, mode: tui.ColorMode = TrueColor) -> Renderer
    val r = Renderer(mode)
    r.render(first)
    r

@test("the first frame clears the screen and writes only the cells that are not blank")
firstFrame()
    val r = Renderer(TrueColor)
    assertEq(r.render(write(grid(3, 1), 0, 0, "ab")), Clear + "ab")
    val blank = Renderer(TrueColor)
    assertEq(blank.render(grid(4, 2)), Clear)

@test("a frame identical to the last writes nothing, again and again")
unchanged()
    val g = write(grid(5, 2), 1, 1, "hey")
    val r = after(g)
    assertEq(r.render(g), "")
    assertEq(r.render(g.copy()), "")

@test("a change on another row moves the cursor there absolutely")
otherRow()
    val r = after(write(grid(5, 3), 0, 0, "ab"))
    assertEq(r.render(write(write(grid(5, 3), 0, 0, "ab"), 2, 1, "x")), E + "2;3H" + "x")
    assertEq(r.render(write(write(grid(5, 3), 0, 0, "ab"), 0, 2, "x")), E + "D " + E + "3H" + "x")

@test("the cursor's home is written as the shortest form")
home()
    val r = after(write(grid(3, 2), 2, 1, "z"))
    assertEq(r.render(write(write(grid(3, 2), 2, 1, "z"), 0, 0, "q")), E + "H" + "q")

@test("a run of changed cells is written with no movement between them")
contiguous()
    val r = after(grid(6, 1))
    assertEq(r.render(write(grid(6, 1), 0, 0, "abcd")), "abcd")
    assertEq(r.render(write(grid(6, 1), 0, 0, "abxy")), E + "2D" + "xy")

@test("a gap on one row is crossed by moving forward where that is shorter than an absolute move")
forward()
    val r = after(grid(20, 1))
    assertEq(r.render(write(write(grid(20, 1), 0, 0, "a"), 6, 0, "b")), "a" + E + "5C" + "b")
    assertEq(cursorMove(3, 0, 15, 0), E + "12C")
    assertEq(cursorMove(15, 4, 3, 4), E + "12D")
    assertEq(cursorMove(1, 0, 0, 0), E + "H")
    assertEq(cursorMove(2, 3, 1, 3), E + "D")
    assertEq(cursorMove(4, 2, 4, 2), "")
    assertEq(cursorMove(-1, 2, 4, 2), E + "3;5H")
    assertEq(cursorMove(0, 0, 0, 1), E + "2H")

@test("a short gap of cells in the current style is written again rather than moved over")
rewriteGap()
    val r = after(grid(10, 1))
    assertEq(r.render(write(grid(10, 1), 0, 0, "a b")), "a b")
    val r2 = after(grid(10, 1))
    assertEq(r2.render(write(write(grid(10, 1), 0, 0, "a"), 3, 0, "b")), "a  b")
    val r3 = after(grid(10, 1))
    assertEq(r3.render(write(write(grid(10, 1), 0, 0, "a"), 4, 0, "b")), "a   b")
    val r4 = after(grid(10, 1))
    assertEq(r4.render(write(write(grid(10, 1), 0, 0, "a"), 5, 0, "b")), "a" + E + "4C" + "b")
    val r5 = after(grid(10, 1))
    assertEq(r5.render(write(grid(10, 1), 1, 0, "z")), " z")

@test("a gap in another style, or holding a wide character, is moved over")
noRewriteAcrossStyles()
    val red = Style.fg(Basic(1))
    val first = write(grid(10, 1), 1, 0, "x", red)
    val r = after(first)
    val next = write(write(write(grid(10, 1), 1, 0, "x", red), 0, 0, "a"), 2, 0, "b")
    assertEq(r.render(next), E + "H" + "a" + E + "C" + "b")
    val wide = write(grid(10, 1), 1, 0, "日")
    val rw = after(wide)
    assertEq(rw.render(write(write(write(grid(10, 1), 1, 0, "日"), 0, 0, "a"), 3, 0, "b")), E + "H" + "a" + E + "2C" + "b")

@test("a styled cell sets its style before it and the frame resets the style at its end")
styledCell()
    val r = after(grid(4, 1))
    val bold = Style(Basic(1), Default, Bold)
    assertEq(r.render(write(grid(4, 1), 0, 0, "ab", bold)), E + "1;31m" + "ab" + E + "0m")
    assertEq(r.render(write(grid(4, 1), 0, 0, "ab", bold)), "")

@test("attributes each have their code, on and off")
attributes()
    val p = Style.plain()
    assertEq(sgr(p, p.with(Bold), TrueColor), E + "1m")
    assertEq(sgr(p, p.with(Dim), TrueColor), E + "2m")
    assertEq(sgr(p, p.with(Italic), TrueColor), E + "3m")
    assertEq(sgr(p, p.with(Underline), TrueColor), E + "4m")
    assertEq(sgr(p, p.with(Reverse), TrueColor), E + "7m")
    assertEq(sgr(p, p.with(Bold | Italic | Underline | Reverse), TrueColor), E + "1;3;4;7m")
    val all = p.with(Bold | Dim | Italic | Underline | Reverse)
    assertEq(sgr(all, all.without(Italic), TrueColor), E + "23m")
    assertEq(sgr(all, all.without(Underline), TrueColor), E + "24m")
    assertEq(sgr(all, all.without(Reverse), TrueColor), E + "27m")
    assertEq(sgr(p.with(Bold), p, TrueColor), E + "0m")
    assertEq(sgr(p, p, TrueColor), "")
    assertEq(sgr(p.with(Bold), p.with(Bold | 64), TrueColor), "")

@test("bold and dim share their off code, so turning one off puts the other back")
boldAndDim()
    val p = Style.plain()
    val both = p.with(Bold | Dim | Underline | Italic)
    assertEq(sgr(both, both.without(Bold), TrueColor), E + "22;2m")
    assertEq(sgr(both, both.without(Dim), TrueColor), E + "22;1m")
    assertEq(sgr(p.with(Bold), p.with(Dim), TrueColor), E + "0;2m")

@test("the shorter of the change and the reset is written")
shorterForm()
    val red = Style(Rgb(200, 10, 10), Default, 0)
    assertEq(sgr(red, Style.plain(), TrueColor), E + "0m")
    assertEq(sgr(red, red.withBg(Basic(4)), TrueColor), E + "44m")
    assertEq(sgr(red.with(Underline), Style(Default, Default, Bold), TrueColor), E + "0;1m")

@test("colours in true colour: default, basic, bright, indexed and RGB, both planes")
trueColorCodes()
    val p = Style.plain()
    assertEq(sgr(p, p.withFg(Basic(0)), TrueColor), E + "30m")
    assertEq(sgr(p, p.withFg(Basic(7)), TrueColor), E + "37m")
    assertEq(sgr(p, p.withFg(Basic(8)), TrueColor), E + "90m")
    assertEq(sgr(p, p.withFg(Basic(15)), TrueColor), E + "97m")
    assertEq(sgr(p, p.withBg(Basic(0)), TrueColor), E + "40m")
    assertEq(sgr(p, p.withBg(Basic(15)), TrueColor), E + "107m")
    assertEq(sgr(p, p.withFg(Indexed(208)), TrueColor), E + "38;5;208m")
    assertEq(sgr(p, p.withBg(Indexed(0)), TrueColor), E + "48;5;0m")
    assertEq(sgr(p, p.withFg(Rgb(1, 2, 3)), TrueColor), E + "38;2;1;2;3m")
    assertEq(sgr(p, p.withBg(Rgb(255, 255, 255)), TrueColor), E + "48;2;255;255;255m")
    assertEq(sgr(p.withFg(Basic(2)), p.withFg(Default).withBg(Basic(2)), TrueColor), E + "0;42m")
    assertEq(sgr(p.withFg(Basic(2)).with(Bold), p.withFg(Basic(3)).with(Bold), TrueColor), E + "33m")

@test("in 256 colours an RGB colour is the nearest of the cube and the greys")
palette256()
    val p = Style.plain()
    assertEq(sgr(p, p.withFg(Rgb(255, 0, 0)), Palette256), E + "38;5;196m")
    assertEq(sgr(p, p.withFg(Rgb(0, 0, 0)), Palette256), E + "38;5;16m")
    assertEq(sgr(p, p.withFg(Rgb(255, 255, 255)), Palette256), E + "38;5;231m")
    assertEq(sgr(p, p.withBg(Rgb(128, 128, 128)), Palette256), E + "48;5;244m")
    assertEq(sgr(p, p.withFg(Indexed(42)), Palette256), E + "38;5;42m")
    assertEq(sgr(p, p.withFg(Basic(3)), Palette256), E + "33m")
    assertEq(tui.nearest256(95, 135, 175), 67)
    assertEq(tui.nearest256(8, 8, 8), 232)
    assertEq(tui.nearest256(238, 238, 238), 255)

@test("in sixteen colours every colour is the nearest basic one")
basic16()
    val p = Style.plain()
    assertEq(sgr(p, p.withFg(Rgb(255, 0, 0)), Basic16), E + "91m")
    assertEq(sgr(p, p.withFg(Rgb(200, 0, 0)), Basic16), E + "31m")
    assertEq(sgr(p, p.withBg(Rgb(0, 0, 0)), Basic16), E + "40m")
    assertEq(sgr(p, p.withFg(Indexed(9)), Basic16), E + "91m")
    assertEq(sgr(p, p.withFg(Indexed(231)), Basic16), E + "97m")
    assertEq(sgr(p, p.withFg(Indexed(232)), Basic16), E + "30m")
    assertEq(sgr(p.withFg(Rgb(255, 0, 0)), p.withFg(Rgb(250, 5, 5)), Basic16), "")

@test("the palette's colours have xterm's values")
indexedRgb()
    assertEq(tui.indexedRgb(16), 0x000000)
    assertEq(tui.indexedRgb(196), 0xff0000)
    assertEq(tui.indexedRgb(231), 0xffffff)
    assertEq(tui.indexedRgb(232), 0x080808)
    assertEq(tui.indexedRgb(255), 0xeeeeee)
    assertEq(tui.indexedRgb(9), 0xff0000)

@test("a two-column character is written once and the cursor steps two columns past it")
wideCharacter()
    val r = after(grid(6, 1))
    assertEq(r.render(write(grid(6, 1), 0, 0, "日x")), "日x")
    val r2 = after(grid(6, 1))
    assertEq(r2.render(write(grid(6, 1), 0, 0, "日本")), "日本")

@test("writing over half of a two-column character blanks the other half on the screen too")
splitWide()
    val r = after(write(grid(4, 1), 0, 0, "日"))
    assertEq(r.render(write(write(grid(4, 1), 0, 0, "日"), 1, 0, "x")), E + "H" + " x")
    val r2 = after(write(grid(4, 1), 1, 0, "日"))
    assertEq(r2.render(write(write(grid(4, 1), 1, 0, "日"), 1, 0, "y")), E + "2D" + "y ")

@test("a two-column character that would end past the edge is a blank")
wideAtEdge()
    val g = write(grid(3, 1), 0, 0, "ab日")
    assertEq(g.rowText(0), "ab ")
    assertEq(Renderer(TrueColor).render(g), Clear + "ab")

@test("after the last column the cursor's place is not trusted, so the next change moves absolutely")
lastColumn()
    val r = after(grid(3, 2))
    assertEq(r.render(write(grid(3, 2), 2, 0, "z")), "  z")
    assertEq(r.render(write(write(grid(3, 2), 2, 0, "z"), 2, 1, "w")), E + "2;3H" + "w")

@test("a frame of another size clears and redraws everything")
resize()
    val r = after(write(grid(3, 1), 0, 0, "abc"))
    assertEq(r.render(write(grid(4, 1), 0, 0, "abc")), Clear + "abc")
    assertEq(r.render(write(grid(4, 2), 0, 0, "abc")), Clear + "abc")
    assertEq(r.render(grid(0, 0)), Clear)

@test("invalidate makes the next frame a full redraw")
invalidated()
    val g = write(grid(3, 1), 0, 0, "abc")
    val r = after(g)
    r.invalidate()
    assertEq(r.render(g), Clear + "abc")

@test("a cell changed only in style is written again")
styleOnly()
    val r = after(write(grid(3, 1), 0, 0, "a"))
    assertEq(r.render(write(grid(3, 1), 0, 0, "a", Style.plain().with(Underline))), E + "H" + E + "4m" + "a" + E + "0m")

@test("a blank with a background is drawn, a blank without one is not")
backgrounds()
    val g = grid(3, 1)
    g.fill(0, 0, 2, 1, Style.plain().withBg(Basic(4)))
    assertEq(Renderer(TrueColor).render(g), Clear + E + "44m" + "  " + E + "0m")

@test("a frame's bytes, as one string, hold every row in order")
manyRows()
    val g = grid(2, 3)
    write(g, 0, 0, "a")
    write(g, 0, 1, "b")
    write(g, 0, 2, "c")
    assertEq(Renderer(TrueColor).render(g), Clear + "a" + E + "2H" + "b" + E + "3H" + "c")
