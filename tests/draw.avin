module tests

// The drawing layer and the widgets, drawn into grids with no terminal: text and its clipping, boxes,
// meters, the table, and the grid's rule for two-column characters.
import dev.avinlang.tui as tui
import dev.avinlang.tui.{Bold, Column, Double, Grid, Heavy, Rect, Rounded, Style, Table}

rows(g: Grid) -> Vector[string] = Vector.tabulate(g.height, y -> g.rowText(y))

@test("text is written from its column and answers the column after it")
textPlain()
  val g = Grid(8, 1)
  assertEq(g.text(1, 0, "abc"), 4)
  assertEq(g.rowText(0), " abc    ")
  assertEq(g.text(0, 0, ""), 0)

@test("text past the right edge is cut, and the answer still counts all of it")
textClippedRight()
  val g = Grid(4, 1)
  assertEq(g.text(2, 0, "hello"), 7)
  assertEq(g.rowText(0), "  he")

@test("text starting left of the grid shows only what is inside")
textClippedLeft()
  val g = Grid(4, 1)
  g.text(-2, 0, "hello")
  assertEq(g.rowText(0), "llo ")

@test("text on a row outside the grid or the clip draws nothing")
textOutsideRows()
  val g = Grid(4, 2)
  g.text(0, -1, "x")
  g.text(0, 2, "x")
  g.text(0, 1, "x", Style.plain(), Rect(0, 0, 4, 1))
  assertEq(rows(g), ["    ", "    "])

@test("text is clipped to the rectangle given")
textClip()
  val g = Grid(10, 1)
  g.text(0, 0, "0123456789", Style.plain(), Rect(3, 0, 4, 1))
  assertEq(g.rowText(0), "   3456   ")

@test("a two-column character cut by the clip's edge leaves its inside half blank")
wideClipped()
  val g = Grid(6, 1)
  g.fill(0, 0, 6, 1, Style.plain())
  g.text(0, 0, "日本語", Style.plain(), Rect(1, 0, 4, 1))
  assertEq(g.rowText(0), "  本  ")
  assertEq(g(1, 0).text, " ")
  assertEq(g(4, 0).text, " ")
  val h = Grid(3, 1)
  h.text(0, 0, "日本", Style.plain(), Rect(1, 0, 0, 1))
  assertEq(h.rowText(0), "   ")

@test("control characters in text are drawn as U+FFFD")
textControls()
  val g = Grid(4, 1)
  g.text(0, 0, "a\tb")
  assertEq(g.rowText(0), "a\u{fffd}b ")

@test("combining marks share their character's cell")
textCombining()
  val g = Grid(3, 1)
  assertEq(g.text(0, 0, "e\u{301}x"), 2)
  assertEq(g(0, 0).text, "e\u{301}")
  assertEq(g(1, 0).text, "x")

@test("writing over half of a two-column character blanks the other half")
gridRule()
  val g = Grid(4, 1)
  g.text(0, 0, "日")
  assertEq(g(1, 0).isContinuation(), true)
  g.text(1, 0, "x")
  assertEq(g.rowText(0), " x  ")
  g.text(1, 0, "日")
  g.text(1, 0, "y")
  assertEq(g.rowText(0), " y  ")
  g.text(0, 0, "日")
  g.text(1, 0, "本")
  assertEq(g.rowText(0), " 本 ")

@test("a grid of no cells draws nothing and traps on a cell read")
emptyGrid()
  val g = Grid(0, 0)
  assertEq(g.text(0, 0, "abc"), 3)
  g.box(Rect(0, 0, 5, 5))
  g.meter(0, 0, 5, 0.5, Style.plain())
  assertEq(g.contains(0, 0), false)

@test("a cell outside the grid traps", should_trap: "outside a grid")
outsideTraps()
  val g = Grid(2, 2)
  g(2, 0)

@test("a grid of a negative size traps", should_trap: "neither may be negative")
negativeGrid()
  Grid(-1, 3)

@test("textIn pads, aligns and cuts with an ellipsis")
textIn()
  val g = Grid(6, 4)
  g.textIn(0, 0, 6, "ab")
  g.textIn(0, 1, 6, "ab", Style.plain(), 1)
  g.textIn(0, 2, 6, "ab", Style.plain(), 0)
  g.textIn(0, 3, 6, "abcdefgh")
  assertEq(rows(g), ["ab    ", "    ab", "  ab  ", "abcde…"])
  assertEq(tui.fitted("日本語", 4), "日…")
  assertEq(tui.fitted("abc", 3), "abc")
  assertEq(tui.fitted("abc", 0), "")
  assertEq(tui.fitted("abc", 1), "…")

@test("a box in each border, with its title set into the top edge")
boxes()
  val g = Grid(8, 3)
  g.box(Rect(0, 0, 8, 3), Style.plain(), tui.Single, "hi")
  assertEq(rows(g), ["┌─hi───┐", "│      │", "└──────┘"])
  val d = Grid(4, 3)
  d.box(Rect(0, 0, 4, 3), Style.plain(), Double)
  assertEq(rows(d), ["╔══╗", "║  ║", "╚══╝"])
  val r = Grid(3, 2)
  r.box(Rect(0, 0, 3, 2), Style.plain(), Rounded)
  assertEq(rows(r), ["╭─╮", "╰─╯"])
  val h = Grid(2, 2)
  h.box(Rect(0, 0, 2, 2), Style.plain(), Heavy)
  assertEq(rows(h), ["┏┓", "┗┛"])

@test("a box's title is cut to fit, and a box too small for one has none")
boxTitles()
  val g = Grid(7, 2)
  g.box(Rect(0, 0, 7, 2), Style.plain(), tui.Single, "a long title")
  assertEq(g.rowText(0), "┌─a …─┐")
  val s = Grid(4, 2)
  s.box(Rect(0, 0, 4, 2), Style.plain(), tui.Single, "x")
  assertEq(s.rowText(0), "┌──┐")

@test("a box narrower or shorter than two cells is not drawn, and one partly outside is clipped")
boxEdges()
  val g = Grid(3, 3)
  g.box(Rect(0, 0, 1, 3))
  g.box(Rect(0, 0, 3, 1))
  assertEq(rows(g), ["   ", "   ", "   "])
  g.box(Rect(1, 1, 5, 5))
  assertEq(rows(g), ["   ", " ┌─", " │ "])
  val c = Grid(5, 3)
  c.box(Rect(0, 0, 5, 3), Style.plain(), tui.Single, "", Rect(0, 0, 2, 3))
  assertEq(rows(c), ["┌─   ", "│    ", "└─   "])

@test("a meter fills in eighths of a cell, rounding to the nearest")
meters()
  val g = Grid(4, 6)
  g.meter(0, 0, 4, 0.0, Style.plain())
  g.meter(0, 1, 4, 1.0, Style.plain())
  g.meter(0, 2, 4, 0.5, Style.plain())
  g.meter(0, 3, 4, 0.03125, Style.plain())
  g.meter(0, 4, 4, 0.6, Style.plain())
  g.meter(0, 5, 4, 0.99, Style.plain())
  assertEq(rows(g), ["    ", "████", "██  ", "▏   ", "██▍ ", "████"])

@test("a meter's fraction below 0, above 1 or not a number is held to the ends")
meterBounds()
  val g = Grid(3, 3)
  g.meter(0, 0, 3, -2.0, Style.plain())
  g.meter(0, 1, 3, 7.5, Style.plain())
  g.meter(0, 2, 3, 0.0 / 0.0, Style.plain())
  assertEq(rows(g), ["   ", "███", "   "])

@test("a meter's part cell takes the filled colour on the empty background")
meterStyles()
  val g = Grid(2, 1)
  val filled = Style(tui.Green, tui.Blue, Bold)
  val empty = Style(tui.White, tui.Black, 0)
  g.meter(0, 0, 2, 0.75, filled, empty)
  assertEq(g(0, 0).style, filled)
  assertEq(g(1, 0).style, Style(tui.Green, tui.Black, Bold))
  g.meter(0, 0, 0, 0.5, filled)
  g.meter(0, 0, 2, 0.0, filled, empty)
  assertEq(g(1, 0).style, empty)

@test("rectangles intersect, inset and hold their cells")
rects()
  val r = Rect(2, 3, 4, 5)
  assertEq(r.right(), 6)
  assertEq(r.bottom(), 8)
  assertEq(r.contains(2, 3), true)
  assertEq(r.contains(6, 3), false)
  assertEq(r.intersect(Rect(0, 0, 4, 4)), Rect(2, 3, 2, 1))
  assertEq(r.intersect(Rect(10, 10, 4, 4)).isEmpty(), true)
  assertEq(r.inset(1), Rect(3, 4, 2, 3))
  assertEq(r.inset(3), Rect(5, 6, 0, 0))

// A table of two columns, a name of width 0 taking what is left and a number of width 3 on the
// right, and `n` rows.
table() -> Table = Table([Column("name", 0), Column("n", 3, 1)])
numbered(n: int) -> Vector[Vector[string]] = Vector.tabulate(n, i -> [s"row$i", s"$i"])

@test("a table draws its headings and rows, widths shared out")
tableDraws()
  val g = Grid(10, 4)
  table().draw(g, g.area(), numbered(2))
  assertEq(rows(g), ["name     n", "row0     0", "row1     1", "          "])

@test("the selected row and the headings are drawn in their styles")
tableStyles()
  val g = Grid(10, 3)
  val t = table()
  t.select(1, 2)
  t.draw(g, g.area(), numbered(2))
  assertEq(g(0, 0).style, t.headerStyle)
  assertEq(g(0, 1).style, t.rowStyle)
  assertEq(g(0, 2).style, t.selectedStyle)
  assertEq(g(9, 2).style, t.selectedStyle)

@test("the table scrolls to keep the selected row in view, both ways")
tableScrolls()
  val g = Grid(10, 3)
  val t = table()
  t.select(5, 10)
  t.draw(g, g.area(), numbered(10))
  assertEq(t.offset, 4)
  assertEq(rows(g), ["name     n", "row4     4", "row5     5"])
  t.select(1, 10)
  t.draw(g, g.area(), numbered(10))
  assertEq(t.offset, 1)
  t.moveBy(100, 10)
  assertEq(t.selected, 9)
  t.draw(g, g.area(), numbered(10))
  assertEq(t.offset, 8)
  t.moveBy(-100, 10)
  assertEq(t.selected, 0)

@test("rows that shrink take the selection and the scroll back with them")
tableShrinks()
  val g = Grid(10, 3)
  val t = table()
  t.select(9, 10)
  t.draw(g, g.area(), numbered(10))
  t.draw(g, g.area(), numbered(3))
  assertEq(t.selected, 2)
  assertEq(t.offset, 1)
  t.draw(g, g.area(), numbered(0))
  assertEq(t.selected, -1)
  assertEq(t.offset, 0)
  assertEq(rows(g), ["name     n", "          ", "          "])

@test("a table's short rows leave cells blank, long ones are cut, and cells past the columns are dropped")
tableCells()
  val g = Grid(10, 4)
  table().draw(g, g.area(), [[], ["a very long name", "12345"], ["x", "1", "extra"]])
  assertEq(rows(g), ["name     n", "          ", "a ver… 12…", "x        1"])

@test("a table in a rectangle of one row shows only the headings, and in none nothing")
tableTiny()
  val g = Grid(10, 2)
  val t = table()
  t.select(3, 5)
  t.draw(g, Rect(0, 0, 10, 1), numbered(5))
  assertEq(rows(g), ["name     n", "          "])
  t.draw(g, Rect(0, 1, 0, 1), numbered(5))
  assertEq(g.rowText(1), "          ")

@test("column widths: fixed ones as given, the flexible share what is left, the last taking the rest")
tableWidths()
  val t = Table([Column("a", 0), Column("b", 4), Column("c", 0)])
  assertEq(t.widths(20), [7, 4, 7])
  assertEq(t.widths(21), [7, 4, 8])
  assertEq(t.widths(3), [0, 4, 0])
  assertEq(Table([]).widths(10), [])
