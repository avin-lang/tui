module tests

// Wrapping text by word, the ellipsis, blocks of text drawn into a rectangle, and the small helpers:
// lines, spans, key hints and labelled values.
import dev.avinlang.tui.{Bold, Ellipsis, Grid, Rect, Span, Style, wrap, withEllipsis}

@test("text wraps at spaces, dropping the spaces where it breaks")
wrapWords()
    assertEq(wrap("the quick brown fox", 10), ["the quick", "brown fox"])
    assertEq(wrap("aaa   bbb", 5), ["aaa", "bbb"])
    assertEq(wrap("ab  ", 10), ["ab"])

@test("words that fit exactly stay on one line, one more column breaks them")
wrapExact()
    assertEq(wrap("abc def", 7), ["abc def"])
    assertEq(wrap("abc def", 6), ["abc", "def"])
    assertEq(wrap("abc", 3), ["abc"])

@test("spaces between two words of a line and an indent at its start are kept")
wrapKeepsSpaces()
    assertEq(wrap("a  b", 10), ["a  b"])
    assertEq(wrap("  ab cd", 5), ["  ab", "cd"])
    assertEq(wrap("   ", 2), ["  "])

@test("a word wider than the line is broken between its clusters, on a line of its own")
wrapLongWord()
    assertEq(wrap("abcdefghij", 4), ["abcd", "efgh", "ij"])
    assertEq(wrap("ab cdefghij", 4), ["ab", "cdef", "ghij"])
    assertEq(wrap("ab", 1), ["a", "b"])

@test("each line of the text wraps on its own, and an empty one stays")
wrapNewlines()
    assertEq(wrap("a\nb", 5), ["a", "b"])
    assertEq(wrap("a\n\nb", 5), ["a", "", "b"])
    assertEq(wrap("", 5), [""])

@test("a width of no columns has no lines")
wrapNoWidth()
    assertEq(wrap("abc", 0), [])
    assertEq(wrap("abc", -1), [])

@test("wide characters are measured as two columns and never split")
wrapWide()
    assertEq(wrap("日本語", 4), ["日本", "語"])
    assertEq(wrap("日本", 3), ["日", "本"])
    assertEq(wrap("日a", 1), ["日", "a"])
    assertEq(wrap("日本 語", 5), ["日本", "語"])

@test("combining marks stay with their character and take no column")
wrapCombining()
    assertEq(wrap("e\u{301}e\u{301} x", 2), ["e\u{301}e\u{301}", "x"])
    assertEq(wrap("e\u{301}e\u{301}e\u{301}", 2), ["e\u{301}e\u{301}", "e\u{301}"])

@test("an ellipsis ends text cut to fit, and stands alone in one column")
ellipsis()
    assertEq(withEllipsis("abcdef", 4), "abc…")
    assertEq(withEllipsis("ab", 4), "ab…")
    assertEq(withEllipsis("日本語", 4), "日…")
    assertEq(withEllipsis("abc", 1), "…")
    assertEq(withEllipsis("abc", 0), "")

@test("a text block wraps, ends the last row with an ellipsis, and counts every line")
blockWraps()
    val g = Grid(6, 3)
    assertEq(g.textBlock(g.area(), "one two three four"), 4)
    assertEq(rows(g), ["one   ", "two   ", "three…"])
    val h = Grid(6, 4)
    assertEq(h.textBlock(h.area(), "one two"), 2)
    assertEq(rows(h), ["one   ", "two   ", "      ", "      "])

@test("a text block can cut each line with an ellipsis instead of wrapping")
blockEllipsis()
    val g = Grid(5, 2)
    assertEq(g.textBlock(g.area(), "abcdefg\nhi", Style.plain(), Ellipsis), 2)
    assertEq(rows(g), ["abcd…", "hi   "])

@test("a text block's lines are placed left, centred or right")
blockAlign()
    val g = Grid(6, 1)
    g.textBlock(g.area(), "ab", align = 1)
    assertEq(g.rowText(0), "    ab")
    val h = Grid(6, 1)
    h.textBlock(h.area(), "ab", align = 0)
    assertEq(h.rowText(0), "  ab  ")

@test("a text block of wide characters in a narrow rectangle, and in none")
blockWideAndTiny()
    val g = Grid(3, 2)
    assertEq(g.textBlock(g.area(), "日本語"), 3)
    assertEq(rows(g), ["日 ", "本…"])
    val h = Grid(3, 1)
    assertEq(h.textBlock(Rect(0, 0, 0, 1), "x"), 0)
    assertEq(h.textBlock(Rect(0, 0, 3, 0), "x"), 1)
    assertEq(h.rowText(0), "   ")

@test("lines across and down, clipped to the grid")
lines()
    val g = Grid(4, 2)
    g.hline(1, 0, 5)
    g.vline(0, 0, 2, ch = '|')
    g.hline(0, 1, 0)
    assertEq(rows(g), ["|───", "|   "])
    g.hline(0, 1, 4, clip = Rect(0, 0, 2, 2))
    assertEq(g.rowText(1), "──  ")

@test("spans are drawn one after another, each in its own style or the one given")
spansStyled()
    val g = Grid(6, 1)
    val bold = Style.plain().with(Bold)
    assertEq(g.spans(0, 0, [Span("ab", Some(bold)), Span("cd")]), 4)
    assertEq(g.rowText(0), "abcd  ")
    assertEq(g(0, 0).style, bold)
    assertEq(g(2, 0).style, Style.plain())
    assertEq(g.spans(1, 0, []), 1)

@test("key hints: the key bold, what it does plain, two spaces between")
keyHints()
    val g = Grid(20, 1)
    assertEq(g.keyHints(0, 0, [("q", "quit"), ("↑↓", "move")]), 15)
    assertEq(g.rowText(0), "q quit  ↑↓ move     ")
    assertEq(g(0, 0).style, Style.plain().with(Bold))
    assertEq(g(2, 0).style, Style.plain())
    assertEq(g(8, 0).style, Style.plain().with(Bold))

@test("a key hint that does not fit whole is left out with the rest")
keyHintsOverflow()
    val g = Grid(10, 1)
    assertEq(g.keyHints(0, 0, [("q", "quit"), ("↑↓", "move")]), 6)
    assertEq(g.rowText(0), "q quit    ")
    val h = Grid(10, 1)
    assertEq(h.keyHints(2, 0, []), 2)
    assertEq(h.keyHints(0, 0, [("Esc", "")]), 3)
    assertEq(h.rowText(0), "Esc       ")
    val tiny = Grid(1, 1)
    assertEq(tiny.keyHints(0, 0, [("q", "quit")]), 0)
    assertEq(tiny.rowText(0), " ")

@test("labels line up in a column and their values are cut with an ellipsis")
labelValues()
    val g = Grid(12, 3)
    assertEq(g.labelValues(g.area(), [("kind", "test"), ("command", "avin test .")]), 2)
    assertEq(rows(g), ["kind    test", "command avi…", "            "])
    assertEq(g(0, 0).style, Style.plain().with(Bold))
    assertEq(g(8, 0).style, Style.plain())

@test("labelled values stop at the last row, and none are drawn into nothing")
labelValuesTiny()
    val g = Grid(8, 1)
    assertEq(g.labelValues(g.area(), [("a", "1"), ("b", "2")]), 1)
    assertEq(g.rowText(0), "a 1     ")
    assertEq(g.labelValues(Rect(0, 0, 0, 1), [("a", "1")]), 0)
    assertEq(g.labelValues(g.area(), []), 0)
    val n = Grid(3, 1)
    n.labelValues(n.area(), [("label", "value")])
    assertEq(n.rowText(0), "la…")
