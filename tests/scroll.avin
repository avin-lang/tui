module tests

// The scroll view's position across draws, following the end, the pager's keys, and the log view's
// limit on the lines it keeps.
import dev.avinlang.tui.{Char, Down, End, Grid, Home, LogView, PageDown, PageUp, Rect, ScrollView, Up}

numberedLines(n: int) -> Vector[string] = Vector.tabulate(n, i -> s"l$i")

@test("a scroll view follows the end to begin with, and keeps following as lines come")
scrollFollows()
    val g = Grid(4, 3)
    val v = ScrollView()
    v.draw(g, g.area(), numberedLines(10))
    assertEq(v.offset, 7)
    assertEq(rows(g), ["l7  ", "l8  ", "l9  "])
    v.draw(g, g.area(), numberedLines(12))
    assertEq(v.offset, 9)
    assertEq(v.follow, true)

@test("moving up stops following, so new lines leave the view where it is")
scrollStays()
    val g = Grid(4, 3)
    val v = ScrollView()
    v.draw(g, g.area(), numberedLines(10))
    v.lineUp()
    assertEq(v.offset, 6)
    assertEq(v.follow, false)
    v.draw(g, g.area(), numberedLines(12))
    assertEq(v.offset, 6)
    assertEq(rows(g), ["l6  ", "l7  ", "l8  "])

@test("a page is the rows less one, held to the ends, and reaching the end follows again")
scrollPages()
    val g = Grid(4, 3)
    val v = ScrollView()
    v.draw(g, g.area(), numberedLines(12))
    v.home()
    assertEq(v.offset, 0)
    assertEq(v.follow, false)
    v.pageDown()
    assertEq(v.offset, 2)
    v.pageUp()
    v.pageUp()
    assertEq(v.offset, 0)
    v.scrollTo(8)
    v.pageDown()
    assertEq(v.offset, 9)
    assertEq(v.follow, true)
    v.draw(g, g.area(), numberedLines(15))
    assertEq(v.offset, 12)
    v.home()
    v.toEnd()
    assertEq(v.offset, 12)
    assertEq(v.follow, true)

@test("the pager's keys move the view, and other keys are not taken")
scrollKeys()
    val g = Grid(4, 3)
    val v = ScrollView()
    v.draw(g, g.area(), numberedLines(12))
    assertEq(v.handle(Home), true)
    assertEq(v.offset, 0)
    assertEq(v.handle(Down), true)
    assertEq(v.offset, 1)
    assertEq(v.handle(PageDown), true)
    assertEq(v.offset, 3)
    assertEq(v.handle(PageUp), true)
    assertEq(v.handle(Up), true)
    assertEq(v.offset, 0)
    assertEq(v.handle(End), true)
    assertEq(v.offset, 9)
    assertEq(v.handle(Char('x')), false)
    assertEq(v.offset, 9)

@test("fewer lines than rows leave the rest blank, and nothing scrolls")
scrollShort()
    val g = Grid(4, 3)
    val v = ScrollView()
    v.draw(g, g.area(), numberedLines(2))
    assertEq(rows(g), ["l0  ", "l1  ", "    "])
    v.scrollBy(5)
    assertEq(v.offset, 0)
    v.scrollBy(-5)
    assertEq(v.offset, 0)
    v.draw(g, g.area(), [])
    assertEq(rows(g), ["    ", "    ", "    "])

@test("lines that shrink take the view back with them")
scrollShrinks()
    val g = Grid(4, 3)
    val v = ScrollView()
    v.draw(g, g.area(), numberedLines(12))
    v.lineUp()
    v.draw(g, g.area(), numberedLines(4))
    assertEq(v.offset, 1)
    assertEq(rows(g), ["l1  ", "l2  ", "l3  "])

@test("a view of one row pages by one, and one of no cells draws nothing")
scrollTiny()
    val g = Grid(4, 1)
    val v = ScrollView()
    v.draw(g, g.area(), numberedLines(5))
    v.home()
    v.pageDown()
    assertEq(v.offset, 1)
    v.draw(g, Rect(0, 0, 0, 0), numberedLines(5))
    assertEq(g.rowText(0), "l4  ")
    v.draw(g, g.area(), numberedLines(5))
    assertEq(g.rowText(0), "l1  ")

@test("long lines are cut at the edge, wide characters whole or blank")
scrollWide()
    val g = Grid(3, 2)
    val v = ScrollView()
    v.draw(g, g.area(), ["日本語", "abcdef"])
    assertEq(rows(g), ["日 ", "abc"])

@test("a log keeps its last lines up to the limit, and splits text at newlines")
logKeeps()
    val log = LogView(limit = 5)
    log.append("a\nb")
    assertEq(log.lines(), ["a", "b"])
    for i in 0 ..< 10
        log.append(s"l$i")
    assertEq(log.lines(), ["l5", "l6", "l7", "l8", "l9"])
    assertEq(log.length(), 5)
    val one = LogView(limit = 0)
    one.append("a\nb")
    assertEq(one.lines(), ["b"])

@test("lines dropped from a log's start move a view that is not following, so it shows the same lines")
logDropsUnderView()
    val g = Grid(3, 2)
    val log = LogView(limit = 5)
    for i in 0 ..< 5
        log.append(s"l$i")
    log.draw(g, g.area())
    assertEq(log.view.offset, 3)
    log.view.scrollTo(2)
    log.draw(g, g.area())
    assertEq(rows(g), ["l2 ", "l3 "])
    log.append("l5")
    assertEq(log.view.offset, 1)
    log.draw(g, g.area())
    assertEq(rows(g), ["l2 ", "l3 "])
    assertEq(log.handle(End), true)
    log.draw(g, g.area())
    assertEq(rows(g), ["l4 ", "l5 "])
    log.clear()
    assertEq(log.length(), 0)
    assertEq(log.view.follow, true)
    log.draw(g, g.area())
    assertEq(rows(g), ["   ", "   "])
