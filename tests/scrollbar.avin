module tests

// The vertical scrollbar: where its thumb sits and how big it is, how it is drawn, and the bar a
// table and a scroll view draw down their right edge when asked to.
import dev.avinlang.tui.{
  Blue, BrightBlack, Column, Cyan, Grid, Home, LogView, Rect, ScrollView, Scrollbar, Style, Table, scrollThumb
}

// Whether two grids hold the same cells, text and style, everywhere.
sameGrid(a: Grid, b: Grid)
  assertEq(a.width, b.width)
  assertEq(a.height, b.height)
  for y in 0 ..< a.height
    for x in 0 ..< a.width
      assertEq(a(x, y), b(x, y))

// A bar `h` cells high drawn into a one-column grid, read back a row to a string.
bar(h: int, total: int, first: int, shown: int) -> Vector[string]
  val g = Grid(1, h)
  g.scrollbar(g.area(), total, first, shown)
  rows(g)

@test("everything fitting, no items and no height give no thumb")
thumbFits()
  assertEq(scrollThumb(10, 10, 0, 10), (0, 0))
  assertEq(scrollThumb(10, 3, 0, 10), (0, 0))
  assertEq(scrollThumb(10, 0, 0, 10), (0, 0))
  assertEq(scrollThumb(0, 50, 0, 10), (0, 0))
  assertEq(scrollThumb(-1, 50, 0, 10), (0, 0))

@test("one item more than fits: a thumb one cell short of the bar, at the top, then at the bottom")
thumbOneMore()
  assertEq(scrollThumb(10, 11, 0, 10), (0, 9))
  assertEq(scrollThumb(10, 11, 1, 10), (1, 9))

@test("the thumb is in proportion to what is shown, rounded, and never under one cell")
thumbSize()
  assertEq(scrollThumb(10, 40, 0, 10), (0, 3))
  assertEq(scrollThumb(10, 20, 0, 10), (0, 5))
  assertEq(scrollThumb(10, 1000000, 0, 10), (0, 1))
  assertEq(scrollThumb(10, 50, 0, 0), (0, 1))
  assertEq(scrollThumb(10, 50, 0, -4), (0, 1))

@test("the thumb is at the top only at the start and at the bottom only at the end")
thumbPlaces()
  assertEq(scrollThumb(10, 40, 0, 10), (0, 3))
  assertEq(scrollThumb(10, 40, 1, 10), (1, 3))
  assertEq(scrollThumb(10, 40, 15, 10), (4, 3))
  assertEq(scrollThumb(10, 40, 29, 10), (6, 3))
  assertEq(scrollThumb(10, 40, 30, 10), (7, 3))
  assertEq(scrollThumb(10, 40, 99, 10), (7, 3))
  assertEq(scrollThumb(10, 40, -5, 10), (0, 3))

@test("huge counts: a one-cell thumb, still off the ends except at them")
thumbHuge()
  assertEq(scrollThumb(10, 1000000, 0, 10), (0, 1))
  assertEq(scrollThumb(10, 1000000, 1, 10), (1, 1))
  assertEq(scrollThumb(10, 1000000, 499995, 10), (5, 1))
  assertEq(scrollThumb(10, 1000000, 999989, 10), (8, 1))
  assertEq(scrollThumb(10, 1000000, 999990, 10), (9, 1))

@test("a bar one cell high is all thumb; one two cells high leaves the top only at the end")
thumbShortBars()
  assertEq(scrollThumb(1, 5, 0, 1), (0, 1))
  assertEq(scrollThumb(1, 5, 2, 1), (0, 1))
  assertEq(scrollThumb(1, 5, 4, 1), (0, 1))
  assertEq(scrollThumb(2, 5, 0, 2), (0, 1))
  assertEq(scrollThumb(2, 5, 1, 2), (0, 1))
  assertEq(scrollThumb(2, 5, 3, 2), (1, 1))
  assertEq(bar(1, 5, 2, 1), ["█"])
  assertEq(bar(2, 5, 0, 2), ["█", "│"])
  assertEq(bar(2, 5, 3, 2), ["│", "█"])

@test("a bar is a track with the thumb over it, cell for cell")
barDraws()
  assertEq(bar(6, 12, 0, 6), ["█", "█", "█", "│", "│", "│"])
  assertEq(bar(6, 12, 1, 6), ["│", "█", "█", "█", "│", "│"])
  assertEq(bar(6, 12, 3, 6), ["│", "│", "█", "█", "█", "│"])
  assertEq(bar(6, 12, 6, 6), ["│", "│", "│", "█", "█", "█"])
  assertEq(bar(6, 1000000, 500000, 6), ["│", "│", "│", "█", "│", "│"])
  val g = Grid(1, 6)
  g.scrollbar(g.area(), 12, 3, 6)
  assertEq(g(0, 0).style, Style.fg(BrightBlack))
  assertEq(g(0, 2).style, Style.plain())

@test("a bar where everything fits draws nothing")
barFitsDrawsNothing()
  val g = Grid(2, 3)
  for y in 0 ..< 3
    g.text(0, y, "xy")
  val before = g.copy()
  g.scrollbar(Rect(1, 0, 1, 3), 3, 0, 3)
  g.scrollbar(Rect(1, 0, 1, 3), 0, 0, 3)
  sameGrid(g, before)

@test("a bar in its own characters and styles; a character not one column wide is the default")
barStyled()
  val g = Grid(2, 4)
  g.scrollbar(Rect(0, 0, 1, 4), 8, 0, 4, Scrollbar(Style.fg(Blue), Style.fg(Cyan), ' ', '▐'))
  g.scrollbar(Rect(1, 0, 1, 4), 8, 4, 4, Scrollbar(trackCh = '漢', thumbCh = '字'))
  assertEq(rows(g), ["▐│", "▐│", " █", " █"])
  assertEq(g(0, 0).style, Style.fg(Cyan))
  assertEq(g(0, 3).style, Style.fg(Blue))

numberedRows(n: int) -> Vector[Vector[string]] = Vector.tabulate(n, i -> [s"row$i", s"$i"])

nameTable() -> Table = Table([Column("name", 0), Column("n", 3, 1)])

@test("a table's bar is off by default and drawing it is as before")
tableBarOff()
  val g = Grid(10, 4)
  val t = nameTable()
  t.draw(g, g.area(), numberedRows(6))
  assertEq(rows(g), ["name     n", "row0     0", "row1     1", "row2     2"])
  assertEq(g(9, 1).style, t.selectedStyle)

@test("a table whose rows fit draws exactly as one with no bar")
tableBarFits()
  for n in [0, 1, 3]
    val off = Grid(10, 4)
    nameTable().draw(off, off.area(), numberedRows(n))
    val on = Grid(10, 4)
    val t = nameTable()
    t.scrollbar = Some(Scrollbar())
    t.draw(on, on.area(), numberedRows(n))
    sameGrid(on, off)

@test("a table with more rows than fit gives its right column to the bar, beside the rows")
tableBarShown()
  val g = Grid(10, 4)
  val t = nameTable()
  t.scrollbar = Some(Scrollbar())
  t.draw(g, g.area(), numberedRows(4))
  assertEq(rows(g), ["name    n ", "row0    0█", "row1    1█", "row2    2│"])
  assertEq(g(9, 0).style, t.headerStyle)
  assertEq(g(8, 1).style, t.selectedStyle)
  assertEq(g(9, 1).style, Style.plain())
  assertEq(g(9, 3).style, Style.fg(BrightBlack))
  t.select(3, 4)
  t.draw(g, g.area(), numberedRows(4))
  assertEq(rows(g), ["name    n ", "row1    1│", "row2    2█", "row3    3█"])

@test("a table's bar with many rows, in the middle and at the end")
tableBarPlaces()
  val g = Grid(10, 7)
  val t = nameTable()
  t.scrollbar = Some(Scrollbar())
  t.select(50, 100)
  t.draw(g, g.area(), numberedRows(100))
  assertEq(t.offset, 45)
  assertEq(Vector.tabulate(6, y -> g(9, y + 1).text), ["│", "│", "█", "│", "│", "│"])
  t.select(99, 100)
  t.draw(g, g.area(), numberedRows(100))
  assertEq(Vector.tabulate(6, y -> g(9, y + 1).text), ["│", "│", "│", "│", "│", "█"])

@test("wide characters in a table's rows stop short of the bar")
tableBarUnicode()
  val g = Grid(10, 3)
  val t = nameTable()
  t.scrollbar = Some(Scrollbar())
  t.draw(g, g.area(), [["漢字", "1"], ["漢字漢字", "2"], ["é", "3"]])
  assertEq(rows(g), ["name    n ", "漢字    1█", "漢字…   2│"])

@test("a scroll view's bar follows the end with it, and moves as the view does")
scrollViewBar()
  val g = Grid(4, 3)
  val v = ScrollView()
  v.scrollbar = Some(Scrollbar())
  v.draw(g, g.area(), numberedLines(10))
  assertEq(rows(g), ["l7 │", "l8 │", "l9 █"])
  v.draw(g, g.area(), numberedLines(12))
  assertEq(rows(g), ["l9 │", "l10│", "l11█"])
  v.lineUp()
  v.draw(g, g.area(), numberedLines(12))
  assertEq(rows(g), ["l8 │", "l9 █", "l10│"])
  v.home()
  v.draw(g, g.area(), numberedLines(12))
  assertEq(rows(g), ["l0 █", "l1 │", "l2 │"])

@test("a scroll view whose lines fit, or with no bar, draws as before")
scrollViewBarFits()
  val off = Grid(4, 3)
  ScrollView().draw(off, off.area(), numberedLines(2))
  val on = Grid(4, 3)
  val v = ScrollView()
  v.scrollbar = Some(Scrollbar())
  v.draw(on, on.area(), numberedLines(2))
  sameGrid(on, off)
  assertEq(rows(on), ["l0  ", "l1  ", "    "])
  val plain = Grid(4, 3)
  ScrollView().draw(plain, plain.area(), numberedLines(10))
  assertEq(rows(plain), ["l7  ", "l8  ", "l9  "])

@test("a wide character cut by the bar's column is its blank half")
scrollViewBarUnicode()
  val g = Grid(4, 2)
  val v = ScrollView()
  v.scrollbar = Some(Scrollbar())
  v.draw(g, g.area(), ["ab漢", "é漢", "x"])
  assertEq(rows(g), ["é漢│", "x  █"])
  v.home()
  v.draw(g, g.area(), ["ab漢", "é漢", "x"])
  assertEq(rows(g), ["ab █", "é漢│"])

@test("a log view draws its view's bar")
logViewBar()
  val g = Grid(3, 2)
  val log = LogView()
  log.view.scrollbar = Some(Scrollbar())
  log.append("a\nb\nc\nd\ne")
  log.draw(g, g.area())
  assertEq(rows(g), ["d │", "e █"])
  log.handle(Home)
  log.draw(g, g.area())
  assertEq(rows(g), ["a █", "b │"])
