module tests

// Character widths and clusters: ASCII, CJK, emoji, combining marks, zero-width joiner sequences,
// variation selectors, flags, control characters, and the edges of the tables.
import dev.avinlang.tui as tui
import dev.avinlang.tui.{Cluster, charWidth, clusters, textWidth}

widths(text: string) -> Vector[int] = clusters(text).map(c -> c.width)
texts(text: string) -> Vector[string] = clusters(text).map(c -> c.text)

@test("printable ASCII is one column each, space and tilde included")
ascii()
  for n in 0x20 ..< 0x7f
    assertEq(charWidth(char(n)), 1)
  assertEq(textWidth("hello, world"), 12)
  assertEq(textWidth(""), 0)

@test("CJK ideographs, kana, Hangul syllables and fullwidth forms are two columns")
eastAsianWide()
  assertEq(charWidth('日'), 2)
  assertEq(charWidth('本'), 2)
  assertEq(charWidth('か'), 2)
  assertEq(charWidth('カ'), 2)
  assertEq(charWidth('한'), 2)
  assertEq(charWidth('Ａ'), 2)
  assertEq(charWidth('\u{3000}'), 2)
  assertEq(charWidth('\u{4e00}'), 2)
  assertEq(charWidth('\u{9fff}'), 2)
  assertEq(charWidth('\u{20000}'), 2)
  assertEq(charWidth('\u{1100}'), 2)
  assertEq(textWidth("日本語"), 6)
  assertEq(textWidth("a日b"), 4)

@test("halfwidth katakana and the ambiguous characters are one column")
narrowEastAsian()
  assertEq(charWidth('ｶ'), 1)
  assertEq(charWidth('±'), 1)
  assertEq(charWidth('é'), 1)
  assertEq(charWidth('Ω'), 1)
  assertEq(charWidth('\u{2500}'), 1)
  assertEq(charWidth('\u{2588}'), 1)

@test("emoji shown as pictures by default are two columns")
emoji()
  assertEq(charWidth('😀'), 2)
  assertEq(charWidth('🚀'), 2)
  assertEq(charWidth('\u{231a}'), 2)
  assertEq(charWidth('\u{2764}'), 1)
  assertEq(textWidth("😀😀"), 4)

@test("combining marks take no column and join the character before them")
combining()
  assertEq(charWidth('\u{301}'), 0)
  assertEq(charWidth('\u{20dd}'), 0)
  assertEq(texts("e\u{301}x"), ["e\u{301}", "x"])
  assertEq(widths("e\u{301}x"), [1, 1])
  assertEq(textWidth("e\u{301}\u{302}\u{303}"), 1)
  assertEq(texts("日\u{3099}"), ["日\u{3099}"])
  assertEq(widths("日\u{3099}"), [2])

@test("zero-width characters with nothing before them are dropped")
leadingMarks()
  assertEq(clusters("\u{301}a").length, 1)
  assertEq(texts("\u{301}\u{200d}a"), ["a"])
  assertEq(clusters("\u{301}").length, 0)

@test("format characters take no column, but the soft hyphen and the number marks are shown")
formatCharacters()
  assertEq(charWidth('\u{200b}'), 0)
  assertEq(charWidth('\u{200d}'), 0)
  assertEq(charWidth('\u{feff}'), 0)
  assertEq(charWidth('\u{ad}'), 1)
  assertEq(charWidth('\u{600}'), 1)

@test("Hangul vowels and finals join the syllable before them")
hangulJamo()
  assertEq(charWidth('\u{1160}'), 0)
  assertEq(charWidth('\u{11ff}'), 0)
  assertEq(widths("\u{1100}\u{1161}\u{11a8}"), [2])

@test("a zero-width joiner takes the next character into its cluster, as wide as the first")
zwjSequences()
  val family = "👨\u{200d}👩\u{200d}👧"
  assertEq(texts(family), [family])
  assertEq(widths(family), [2])
  assertEq(widths(family + "x"), [2, 1])
  assertEq(widths("a\u{200d}b"), [1])
  assertEq(texts("a\u{200d}"), ["a\u{200d}"])

@test("a variation selector 16 widens an emoji, and only an emoji beyond ASCII")
variationSelector()
  assertEq(widths("\u{2764}\u{fe0f}"), [2])
  assertEq(widths("\u{2764}"), [1])
  assertEq(widths("1\u{fe0f}"), [1])
  assertEq(widths("a\u{fe0f}"), [1])
  assertEq(widths("😀\u{fe0f}"), [2])
  assertEq(widths("\u{2764}\u{fe0e}"), [1])

@test("two regional indicators are one flag of two columns; a third starts another")
flags()
  assertEq(widths("🇯🇵"), [2])
  assertEq(texts("🇯🇵"), ["🇯🇵"])
  assertEq(widths("🇯🇵🇫🇷"), [2, 2])
  assertEq(clusters("🇯🇵🇫").length, 2)

@test("control characters are each a cluster of U+FFFD, one column, never joined")
controls()
  assertEq(texts("a\tb"), ["a", "\u{fffd}", "b"])
  assertEq(texts("\u{0}\u{1b}\u{7f}\u{85}\u{9f}"), ["\u{fffd}", "\u{fffd}", "\u{fffd}", "\u{fffd}", "\u{fffd}"])
  assertEq(texts("\n\u{301}"), ["\u{fffd}"])
  assertEq(tui.sanitize('\u{7}'), '\u{fffd}')
  assertEq(tui.sanitize('a'), 'a')
  assertEq(charWidth('\u{1b}'), 1)

@test("the edges of the planes and of the tables")
edges()
  assertEq(charWidth('\u{a0}'), 1)
  assertEq(charWidth('\u{ffff}'), 1)
  assertEq(charWidth('\u{10ffff}'), 1)
  assertEq(charWidth('\u{e0001}'), 0)
  assertEq(charWidth('\u{e01ef}'), 0)
  assertEq(charWidth('\u{3fffd}'), 2)
  assertEq(charWidth('\u{40000}'), 1)

@test("the tables are of the Unicode version they say")
version()
  assertEq(tui.unicodeVersion, "16.0.0")
