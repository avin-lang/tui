module tests

// Segmented gauges: how the cells are shared out against a budget, and how the gauge is drawn.
import dev.avinlang.tui.{
  Blue, BrightBlack, Cyan, Green, Grid, Magenta, Rect, Red, Segment, Style, Yellow, gaugeCells,
  gaugeBars, gaugeEighths
}

@test("segments take their share of the budget, laid end to end")
gaugeShares()
  val s = Style.fg(Green)
  assertEq(gaugeCells(10, [Segment(3.0, s), Segment(2.0, s)], 10.0), [3, 2])
  assertEq(gaugeCells(10, [Segment(10.0, s)], 10.0), [10])
  assertEq(gaugeCells(10, [], 10.0), [])

@test("boundaries round to the nearest cell, so the cells add up as the amounts do")
gaugeRounding()
  val s = Style.fg(Green)
  assertEq(gaugeCells(4, [Segment(1.0, s), Segment(1.0, s), Segment(1.0, s)], 3.0), [1, 2, 1])
  assertEq(gaugeCells(10, [Segment(0.04, s)], 1.0), [0])
  assertEq(gaugeCells(10, [Segment(0.06, s)], 1.0), [1])

@test("what passes the budget is cut off at the end")
gaugeOverflow()
  val s = Style.fg(Green)
  assertEq(gaugeCells(5, [Segment(4.0, s), Segment(4.0, s)], 6.0), [3, 2])
  assertEq(gaugeCells(5, [Segment(9.0, s), Segment(1.0, s)], 6.0), [5, 0])

@test("a budget of nothing, negative amounts and amounts that are not numbers take no cells")
gaugeDegenerate()
  val s = Style.fg(Green)
  assertEq(gaugeCells(4, [Segment(1.0, s), Segment(2.0, s)], 0.0), [0, 0])
  assertEq(gaugeCells(4, [Segment(1.0, s)], -1.0), [0])
  assertEq(gaugeCells(4, [Segment(-2.0, s), Segment(2.0, s)], 4.0), [0, 2])
  assertEq(gaugeCells(4, [Segment(0.0 / 0.0, s), Segment(2.0, s)], 4.0), [0, 2])
  assertEq(gaugeCells(4, [Segment(1.0, s)], 0.0 / 0.0), [0])
  assertEq(gaugeCells(0, [Segment(1.0, s)], 1.0), [0])
  assertEq(gaugeCells(-3, [Segment(1.0, s)], 1.0), [0])

@test("a gauge between brackets: each segment in its character and style, the rest dotted")
gaugeDraws()
  val g = Grid(12, 1)
  val green = Style.fg(Green)
  val magenta = Style.fg(Magenta)
  assertEq(g.gauge(0, 0, 12, [Segment(5.0, green), Segment(3.0, magenta, '▒')], 10.0), 12)
  assertEq(g.rowText(0), "[█████▒▒▒··]")
  assertEq(g(0, 0).style, Style.plain())
  assertEq(g(1, 0).style, green)
  assertEq(g(6, 0).style, magenta)
  assertEq(g(9, 0).style, Style.fg(BrightBlack))
  assertEq(g(11, 0).style, Style.plain())

@test("a gauge without brackets, and one too narrow for them")
gaugeUnbracketed()
  val s = Style.fg(Green)
  val g = Grid(4, 1)
  g.gauge(0, 0, 4, [Segment(1.0, s)], 2.0, brackets = false)
  assertEq(g.rowText(0), "██··")
  val h = Grid(4, 1)
  h.gauge(0, 0, 2, [Segment(1.0, s)], 1.0)
  assertEq(h.rowText(0), "██  ")
  val k = Grid(4, 1)
  k.gauge(1, 0, 1, [Segment(0.4, s)], 2.0)
  assertEq(k.rowText(0), " ·  ")

@test("a gauge of no width draws nothing, and one is clipped to its rectangle")
gaugeTinyAndClipped()
  val s = Style.fg(Green)
  val g = Grid(6, 1)
  assertEq(g.gauge(2, 0, 0, [Segment(1.0, s)], 1.0), 2)
  assertEq(g.rowText(0), "      ")
  g.gauge(0, 0, 6, [Segment(1.0, s)], 1.0, clip = Rect(0, 0, 3, 1))
  assertEq(g.rowText(0), "[██   ")
  val h = Grid(4, 1)
  h.gauge(2, 0, 6, [Segment(1.0, s)], 1.0)
  assertEq(h.rowText(0), "  [█")

@test("a wide character for a segment or the rest is drawn one column wide")
gaugeWideChars()
  val g = Grid(6, 1)
  g.gauge(0, 0, 6, [Segment(1.0, Style.fg(Green), '日')], 2.0, rest = '本')
  assertEq(g.rowText(0), "[██··]")

@test("a boundary on an exact half of a cell rounds up, however the budget divides")
gaugeExactHalves()
  val s = Style.fg(Green)
  // 15 of 22 in 11 cells is 7.5 cells; 15 / 22 * 11 falls just under it
  assertEq(gaugeCells(11, [Segment(0.0, s), Segment(15.0, s)], 22.0), [0, 8])
  assertEq(gaugeCells(11, [Segment(15.0, s)], 22.0), [8])
  for k in 0 ..< 23
    assertEq(gaugeCells(11, [Segment(real(k), s)], 22.0), [(k + 1) / 2])
  for k in 0 ..< 101
    assertEq(gaugeCells(10, [Segment(real(k), s)], 100.0), [(k + 5) / 10])
  for k in 0 ..< 57
    assertEq(gaugeCells(7, [Segment(real(k), s)], 56.0), [(k + 4) / 8])
  assertEq(gaugeCells(3, [Segment(1.0, s)], 2.0), [2])
  assertEq(gaugeCells(7, [Segment(1.0, s), Segment(1.0, s)], 2.0), [4, 3])

@test("just under and just over a half, and the ends of the budget")
gaugeHalfNeighbours()
  val s = Style.fg(Green)
  assertEq(gaugeCells(10, [Segment(0.0499, s)], 1.0), [0])
  assertEq(gaugeCells(10, [Segment(0.05, s)], 1.0), [1])
  assertEq(gaugeCells(10, [Segment(0.9499, s)], 1.0), [9])
  assertEq(gaugeCells(10, [Segment(0.95, s)], 1.0), [10])
  assertEq(gaugeCells(10, [Segment(0.9999, s)], 1.0), [10])
  assertEq(gaugeCells(10, [Segment(1.0, s), Segment(0.5, s)], 1.0), [10, 0])
  assertEq(gaugeCells(1, [Segment(1.0, s)], 2.0), [1])
  assertEq(gaugeCells(1, [Segment(0.99, s)], 2.0), [0])

@test("eighths: each boundary at the nearest eighth of a cell, halves rounding up")
gaugeEighthCounts()
  val s = Style.fg(Green)
  for k in 0 ..< 17
    assertEq(gaugeEighths(1, [Segment(real(k), s)], 16.0), [(k + 1) / 2])
  assertEq(gaugeEighths(2, [Segment(3.0, s), Segment(2.0, s)], 8.0), [6, 4])
  assertEq(gaugeEighths(11, [Segment(0.0, s), Segment(15.0, s)], 22.0), [0, 60])
  assertEq(gaugeEighths(2, [Segment(9.0, s), Segment(9.0, s)], 10.0), [14, 2])
  assertEq(gaugeEighths(0, [Segment(1.0, s)], 1.0), [0])
  assertEq(gaugeEighths(-2, [Segment(1.0, s)], 1.0), [0])
  assertEq(gaugeEighths(3, [], 1.0), [])
  assertEq(gaugeEighths(3, [Segment(1.0, s)], 0.0), [0])
  assertEq(gaugeEighths(3, [Segment(0.0 / 0.0, s), Segment(-1.0, s), Segment(1.0, s)], 3.0), [0, 0, 8])

@test("an eighths gauge draws a part cell as a left block in the segment's colour on the empty background")
gaugeEighthsDraw()
  val cyan = Style.fg(Cyan)
  val blue = Style.fg(Blue)
  val empty = Style(BrightBlack, Red, 0)
  val g = Grid(4, 1)
  assertEq(
    g.gauge(0, 0, 4, [Segment(3.0, cyan), Segment(2.0, blue)], 16.0, empty = empty, brackets = false, eighths = true),
    4
  )
  // cyan ends at 6 eighths, blue at 10: cell 0 is cyan's, cell 1 blue's, the rest empty
  assertEq(g.rowText(0), "▊▎··")
  assertEq(g(0, 0).style, Style(Cyan, Blue, 0))
  assertEq(g(1, 0).style, Style(Blue, Red, 0))
  assertEq(g(2, 0).style, empty)
  val h = Grid(6, 1)
  h.gauge(0, 0, 6, [Segment(1.0, cyan), Segment(1.0, blue, '▒')], 2.0, eighths = true)
  assertEq(h.rowText(0), "[██▒▒]")
  assertEq(h(2, 0).style, cyan)
  assertEq(h(3, 0).style, blue)

@test("an eighths gauge: a segment inside another's part cell is hidden, and each block width shows")
gaugeEighthsInsideOneCell()
  val cyan = Style.fg(Cyan)
  val blue = Style.fg(Blue)
  val g = Grid(1, 1)
  // cyan ends at 2 eighths, blue at 5, both inside the one cell: the cell is cyan's
  g.gauge(0, 0, 1, [Segment(2.0, cyan), Segment(3.0, blue)], 8.0, eighths = true)
  assertEq(g.rowText(0), "▎")
  assertEq(g(0, 0).style.fg, Cyan)
  val blocks = " ▏▎▍▌▋▊▉█"
  for k in 1 ..< 9
    val h = Grid(1, 1)
    h.gauge(0, 0, 1, [Segment(real(k), cyan)], 8.0, rest = '·', eighths = true)
    assertEq(h.rowText(0), blocks.chars(k).toString())
  val e = Grid(1, 1)
  e.gauge(0, 0, 1, [Segment(0.0, cyan)], 8.0, eighths = true)
  assertEq(e.rowText(0), "·")

@test("an eighths gauge: overflow cut at the end, no budget, tiny widths, wide characters and the clip")
gaugeEighthsEdges()
  val cyan = Style.fg(Cyan)
  val g = Grid(5, 1)
  g.gauge(0, 0, 5, [Segment(9.0, cyan), Segment(9.0, Style.fg(Blue))], 4.0, eighths = true)
  assertEq(g.rowText(0), "[███]")
  assertEq(g(3, 0).style, cyan)
  val n = Grid(5, 1)
  n.gauge(0, 0, 5, [Segment(1.0, cyan)], 0.0, rest = ' ', eighths = true)
  assertEq(n.rowText(0), "[   ]")
  val z = Grid(3, 1)
  assertEq(z.gauge(1, 0, 0, [Segment(1.0, cyan)], 1.0, eighths = true), 1)
  assertEq(z.rowText(0), "   ")
  z.gauge(1, 0, 1, [Segment(1.0, cyan)], 2.0, eighths = true)
  assertEq(z.rowText(0), " ▌ ")
  val two = Grid(2, 1)
  two.gauge(0, 0, 2, [Segment(3.0, cyan)], 4.0, eighths = true)
  assertEq(two.rowText(0), "█▌")
  val w = Grid(4, 1)
  w.gauge(0, 0, 4, [Segment(1.0, cyan, '日')], 1.0, rest = '本', eighths = true)
  assertEq(w.rowText(0), "[██]")
  val half = Grid(4, 1)
  half.gauge(0, 0, 4, [Segment(1.0, cyan, '日')], 4.0, rest = '本', eighths = true)
  assertEq(half.rowText(0), "[▌·]")
  val c = Grid(6, 1)
  c.gauge(0, 0, 6, [Segment(1.0, cyan)], 1.0, clip = Rect(0, 0, 3, 1), eighths = true)
  assertEq(c.rowText(0), "[██   ")

// marshal top's memory bar as it draws it by hand: two meters, the reserved one over the held one.
topMemBar(g: Grid, x: int, y: int, width: int, reserved: int, held: int, budget: int)
  g.text(x, y, "[")
  val share = (part: int) -> if budget > 0 then (if part >= budget then 1.0 else real(part) / real(budget)) else 0.0
  val mine = share(reserved)
  if held > reserved && budget > 0
    g.meter(x + 1, y, width, share(held), Style.fg(Blue), Style.fg(BrightBlack))
    val eighths = int(mine * real(width * 8) + 0.5)
    val cells = (eighths + 7) / 8
    if cells > 0 then g.meter(x + 1, y, width, mine, Style.fg(Cyan), Style.fg(BrightBlack), Rect(x + 1, y, cells, 1))
  else
    g.meter(x + 1, y, width, mine, Style.fg(Cyan), Style.fg(BrightBlack))
  g.text(x + 1 + width, y, "]")

// Whether `part` of `budget` in `width` cells falls on an exact half of an eighth, where top's
// rounding (of the quotient first) and the gauge's (of the product first) may differ.
onHalfEighth(part: int, budget: int, width: int) -> bool =
  0 < part < budget && part * width * 16 % budget == 0 && part * width * 16 / budget % 2 == 1

@test("an eighths gauge of the reserved part then the rest of the held draws top's memory bar cell for cell")
gaugeMatchesTopMemBar()
  for budget in [0, 7, 10, 24, 56]
    for width in 1 ..< 13
      for reserved in 0 ..< budget + 3
        for held in reserved - 2 ..< budget + 4
          if onHalfEighth(reserved, budget, width) || onHalfEighth(held, budget, width) then continue
          val want = Grid(width + 4, 1)
          topMemBar(want, 1, 0, width, reserved, held, budget)
          val got = Grid(width + 4, 1)
          val after = got.gauge(
            1,
            0,
            width + 2,
            [Segment(real(reserved), Style.fg(Cyan)), Segment(real(held - reserved), Style.fg(Blue))],
            real(budget),
            rest = ' ',
            eighths = true
          )
          assertEq(after, width + 3)
          assertEq(got.rowText(0), want.rowText(0))
          for i in 0 ..< width + 4
            if got(i, 0).style != want(i, 0).style
              // a cell shared by the two segments: top's block sits on the default background, the
              // gauge's on the colour of the segment after it
              assertEq(got(i, 0).style, Style(want(i, 0).style.fg, Blue, want(i, 0).style.attrs))

// A gauge 12 columns wide, ten cells of eighths, against a budget of 80 so an amount is its eighths.
eighthsOf(segments: Vector[Segment]) -> Grid
  val g = Grid(12, 1)
  g.gauge(0, 0, 12, segments, 80.0, rest = ' ', eighths = true)
  g

// Each of the ten cells: whole blocks `#`, empty `.`, anything else as its glyph.
glyphsOf(g: Grid) -> string = (1 .. 10).map(
  x -> if g(x, 0).text == "█" then "#" elif g(x, 0).text == " " then "." else g(x, 0).text
).mkString("")

@test("an eighths gauge: a first segment of no eighths draws nothing, the next one starting at the first cell")
gaugeEighthsZeroFirst()
  val g = eighthsOf([Segment(0.0, Style.fg(Green)), Segment(24.0, Style.fg(Yellow))])
  assertEq(glyphsOf(g), "###.......")
  for x in 1 ..< 4
    assertEq(g(x, 0).style, Style.fg(Yellow))
  assertEq(g(0, 0).text, "[")
  assertEq(g(11, 0).text, "]")

@test("an eighths gauge: a tiny first segment is a sliver over the colour of the next, never a black cell")
gaugeEighthsTinyFirst()
  val g = eighthsOf([Segment(1.0, Style.fg(Cyan)), Segment(40.0, Style.fg(Blue))])
  assertEq(glyphsOf(g), "▏####▏....")
  assertEq(g(1, 0).style, Style(Cyan, Blue, 0))
  assertEq(g(2, 0).style, Style.fg(Blue))
  assertEq(g(6, 0).style, Style(Blue, Style.plain().bg, 0))

@test("an eighths gauge: segments exactly filling whole cells draw whole cells and no blocks")
gaugeEighthsExactCells()
  val g = eighthsOf([Segment(16.0, Style.fg(Cyan)), Segment(8.0, Style.fg(Blue))])
  assertEq(glyphsOf(g), "###.......")
  assertEq(g(2, 0).style, Style.fg(Cyan))
  assertEq(g(3, 0).style, Style.fg(Blue))

@test("an eighths gauge: no amount draws an empty gauge and a full budget fills it")
gaugeEighthsEmptyAndFull()
  assertEq(glyphsOf(eighthsOf([Segment(0.0, Style.fg(Cyan)), Segment(0.0, Style.fg(Blue))])), "..........")
  assertEq(glyphsOf(eighthsOf([])), "..........")
  val g = eighthsOf([Segment(80.0, Style.fg(Cyan))])
  assertEq(glyphsOf(g), "##########")
  assertEq(g(10, 0).style, Style.fg(Cyan))

@test("an eighths gauge: a cell shared by two segments is the first one's block over the second one's colour")
gaugeEighthsSharedCell()
  val g = eighthsOf([Segment(28.0, Style.fg(Cyan)), Segment(20.0, Style.fg(Blue))])
  assertEq(glyphsOf(g), "###▌##....")
  assertEq(g(4, 0).style, Style(Cyan, Blue, 0))
  assertEq(g(5, 0).style, Style.fg(Blue))
  // the last segment's partial cell sits on the empty background
  val h = eighthsOf([Segment(28.0, Style.fg(Cyan))])
  assertEq(glyphsOf(h), "###▌......")
  assertEq(h(4, 0).style, Style(Cyan, Style.plain().bg, 0))
  // a middle segment of no eighths is skipped when finding what follows
  val m = eighthsOf([Segment(28.0, Style.fg(Cyan)), Segment(0.0, Style.fg(Red)), Segment(20.0, Style.fg(Blue))])
  assertEq(m(4, 0).style, Style(Cyan, Blue, 0))

// A 12-column bars gauge (10 cells inside the brackets) of `segments` against a budget of 10, with
// `label`.
private barsOf(segments: Vector[Segment], label: string = "", width: int = 12) -> Grid
  val g = Grid(width, 1)
  g.gauge(0, 0, width, segments, 10.0, bars = true, label = label)
  g

@test("a bars gauge shares cells as gaugeCells does when every segment rounds to a cell")
gaugeBarsShares()
  val s = Style.fg(Green)
  assertEq(gaugeBars(10, [Segment(3.0, s), Segment(2.0, s)], 10.0), [3, 2])
  assertEq(gaugeBars(4, [Segment(1.0, s), Segment(1.0, s), Segment(1.0, s)], 3.0), [1, 2, 1])
  assertEq(gaugeBars(10, [], 10.0), [])

@test("a bars gauge gives a segment too small for half a cell one cell, if the gauge fills any")
gaugeBarsTinySegment()
  val s = Style.fg(Green)
  assertEq(gaugeBars(10, [Segment(5.0, s), Segment(0.01, s)], 10.0), [5, 1])
  // a tiny first segment takes its cell from the one after it, whose boundary stays where it was
  assertEq(gaugeBars(10, [Segment(0.01, s), Segment(5.0, s)], 10.0), [1, 4])
  assertEq(gaugeBars(10, [Segment(0.01, s), Segment(0.01, s), Segment(5.0, s)], 10.0), [1, 1, 3])
  // the whole gauge rounds to no cell: nothing shows
  assertEq(gaugeBars(10, [Segment(0.04, s)], 1.0), [0])
  assertEq(gaugeBars(10, [Segment(0.02, s), Segment(0.02, s)], 1.0), [0, 0])
  // the gauge rounds to a cell, so a tiny segment after it still gets its own
  assertEq(gaugeBars(10, [Segment(0.06, s), Segment(0.01, s)], 1.0), [1, 1])
  // amounts of nothing, negative or not a number take no cell
  assertEq(gaugeBars(10, [Segment(5.0, s), Segment(0.0, s), Segment(-1.0, s), Segment(0.0 / 0.0, s)], 10.0), [5, 0, 0, 0])

@test("a bars gauge never takes more cells than its width")
gaugeBarsCapped()
  val s = Style.fg(Green)
  assertEq(gaugeBars(5, [Segment(9.0, s), Segment(1.0, s)], 6.0), [5, 0])
  assertEq(gaugeBars(5, [Segment(4.95, s), Segment(0.01, s)], 5.0), [5, 0])
  assertEq(gaugeBars(3, [Segment(2.9, s), Segment(0.01, s), Segment(0.01, s)], 3.0), [3, 0, 0])
  assertEq(gaugeBars(0, [Segment(1.0, s)], 1.0), [0])
  assertEq(gaugeBars(-2, [Segment(1.0, s)], 1.0), [0])

@test("an empty bars gauge is blank between its brackets")
gaugeBarsEmpty()
  val g = barsOf([Segment(0.0, Style.fg(Green))])
  assertEq(g.rowText(0), "[          ]")
  assertEq(g(1, 0).style, Style.fg(BrightBlack))
  assertEq(barsOf([]).rowText(0), "[          ]")

@test("a full bars gauge is a | in every cell, and one over the budget is cut at the end")
gaugeBarsFullAndOver()
  val green = Style.fg(Green)
  assertEq(barsOf([Segment(10.0, green)]).rowText(0), "[||||||||||]")
  val g = barsOf([Segment(8.0, green), Segment(7.0, Style.fg(Red))])
  assertEq(g.rowText(0), "[||||||||||]")
  assertEq(g(8, 0).style, green)
  assertEq(g(9, 0).style, Style.fg(Red))
  assertEq(g(10, 0).style, Style.fg(Red))
  assertEq(g(11, 0).style, Style.plain())

@test("a bars gauge draws each segment's cells in its style, whatever its character")
gaugeBarsSegments()
  val g = barsOf([Segment(3.0, Style.fg(Green)), Segment(2.0, Style.fg(Blue), '▒'), Segment(0.1, Style.fg(Yellow))])
  assertEq(g.rowText(0), "[||||||    ]")
  for x in 1 ..< 4
    assertEq(g(x, 0).style, Style.fg(Green))
  assertEq(g(4, 0).style, Style.fg(Blue))
  assertEq(g(5, 0).style, Style.fg(Blue))
  assertEq(g(6, 0).style, Style.fg(Yellow))
  assertEq(g(7, 0).style, Style.fg(BrightBlack))

@test("a bars label sits right-aligned inside the brackets, in the style of the cells it covers")
gaugeBarsLabel()
  val g = barsOf([Segment(8.0, Style.fg(Green))], "4/5")
  assertEq(g.rowText(0), "[|||||||4/5]")
  assertEq(g(8, 0).style, Style.fg(Green))
  assertEq(g(9, 0).style, Style.fg(BrightBlack))
  assertEq(g(10, 0).style, Style.fg(BrightBlack))
  assertEq(g(11, 0).text, "]")
  val full = barsOf([Segment(3.0, Style.fg(Green)), Segment(7.0, Style.fg(Red))], "10/10")
  assertEq(full.rowText(0), "[|||||10/10]")
  assertEq(full(6, 0).style, Style.fg(Red))

@test("a bars label on an empty gauge is drawn in the empty style")
gaugeBarsLabelOnEmpty()
  val g = barsOf([], "0/12")
  assertEq(g.rowText(0), "[      0/12]")
  for x in 7 ..< 11
    assertEq(g(x, 0).style, Style.fg(BrightBlack))

@test("a bars label wider than the gauge is cut at its end")
gaugeBarsLabelCut()
  assertEq(barsOf([Segment(5.0, Style.fg(Green))], "123456789abcdef").rowText(0), "[123456789a]")
  assertEq(barsOf([Segment(5.0, Style.fg(Green))], "0123456789").rowText(0), "[0123456789]")

@test("a bars label of wide and combining characters takes the columns it is drawn in")
gaugeBarsLabelUnicode()
  val g = barsOf([Segment(10.0, Style.fg(Green))], "é日本")
  assertEq(g.rowText(0), "[|||||é日本]")
  assertEq(g(7, 0).style, Style.fg(Green))
  // a two-column character that would not fit whole is cut with what follows it
  assertEq(barsOf([], "ab日本", width = 5).rowText(0), "[ ab]")
  assertEq(barsOf([], "日本語", width = 7).rowText(0), "[ 日本]")

@test("a bars gauge one to three columns wide, with and without its label")
gaugeBarsNarrow()
  val green = Style.fg(Green)
  assertEq(barsOf([Segment(10.0, green)], width = 1).rowText(0), "|")
  assertEq(barsOf([Segment(0.0, green)], width = 1).rowText(0), " ")
  assertEq(barsOf([Segment(10.0, green)], width = 2).rowText(0), "||")
  assertEq(barsOf([Segment(5.0, green)], width = 3).rowText(0), "[|]")
  assertEq(barsOf([Segment(4.0, green)], width = 3).rowText(0), "[ ]")
  assertEq(barsOf([Segment(10.0, green)], "7", width = 3).rowText(0), "[7]")
  assertEq(barsOf([Segment(10.0, green)], "78", width = 3).rowText(0), "[7]")
  assertEq(barsOf([], "xy", width = 2).rowText(0), "xy")
  assertEq(barsOf([], "xyz", width = 1).rowText(0), "x")

@test("a label is drawn the same way in the other gauge modes")
gaugeLabelOtherModes()
  val g = Grid(12, 1)
  g.gauge(0, 0, 12, [Segment(5.0, Style.fg(Green))], 10.0, label = "50%")
  assertEq(g.rowText(0), "[█████··50%]")
  assertEq(g(8, 0).style, Style.fg(BrightBlack))
