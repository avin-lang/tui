module tests

// Segmented gauges: how the cells are shared out against a budget, and how the gauge is drawn.
import dev.avinlang.tui.{BrightBlack, Green, Grid, Magenta, Rect, Segment, Style, gaugeCells}

@test("segments take their share of the budget, laid end to end")
gaugeShares()
    val s = Style.fg(Green)
    assertEq(gaugeCells(10, [Segment(3.0, s), Segment(2.0, s)], 10.0), [3, 2])
    assertEq(gaugeCells(10, [Segment(10.0, s)], 10.0), [10])
    assertEq(gaugeCells(10, [], 10.0), [])

@test("boundaries round to the nearest cell, so the cells add up as the amounts do")
gaugeRounding()
    val s = Style.fg(Green)
    assertEq(gaugeCells(4, [Segment(1.0, s), Segment(1.0, s), Segment(1.0, s)], 3.0), [1, 2, 1])
    assertEq(gaugeCells(10, [Segment(0.04, s)], 1.0), [0])
    assertEq(gaugeCells(10, [Segment(0.06, s)], 1.0), [1])

@test("what passes the budget is cut off at the end")
gaugeOverflow()
    val s = Style.fg(Green)
    assertEq(gaugeCells(5, [Segment(4.0, s), Segment(4.0, s)], 6.0), [3, 2])
    assertEq(gaugeCells(5, [Segment(9.0, s), Segment(1.0, s)], 6.0), [5, 0])

@test("a budget of nothing, negative amounts and amounts that are not numbers take no cells")
gaugeDegenerate()
    val s = Style.fg(Green)
    assertEq(gaugeCells(4, [Segment(1.0, s), Segment(2.0, s)], 0.0), [0, 0])
    assertEq(gaugeCells(4, [Segment(1.0, s)], -1.0), [0])
    assertEq(gaugeCells(4, [Segment(-2.0, s), Segment(2.0, s)], 4.0), [0, 2])
    assertEq(gaugeCells(4, [Segment(0.0 / 0.0, s), Segment(2.0, s)], 4.0), [0, 2])
    assertEq(gaugeCells(4, [Segment(1.0, s)], 0.0 / 0.0), [0])
    assertEq(gaugeCells(0, [Segment(1.0, s)], 1.0), [0])
    assertEq(gaugeCells(-3, [Segment(1.0, s)], 1.0), [0])

@test("a gauge between brackets: each segment in its character and style, the rest dotted")
gaugeDraws()
    val g = Grid(12, 1)
    val green = Style.fg(Green)
    val magenta = Style.fg(Magenta)
    assertEq(g.gauge(0, 0, 12, [Segment(5.0, green), Segment(3.0, magenta, '▒')], 10.0), 12)
    assertEq(g.rowText(0), "[█████▒▒▒··]")
    assertEq(g(0, 0).style, Style.plain())
    assertEq(g(1, 0).style, green)
    assertEq(g(6, 0).style, magenta)
    assertEq(g(9, 0).style, Style.fg(BrightBlack))
    assertEq(g(11, 0).style, Style.plain())

@test("a gauge without brackets, and one too narrow for them")
gaugeUnbracketed()
    val s = Style.fg(Green)
    val g = Grid(4, 1)
    g.gauge(0, 0, 4, [Segment(1.0, s)], 2.0, brackets = false)
    assertEq(g.rowText(0), "██··")
    val h = Grid(4, 1)
    h.gauge(0, 0, 2, [Segment(1.0, s)], 1.0)
    assertEq(h.rowText(0), "██  ")
    val k = Grid(4, 1)
    k.gauge(1, 0, 1, [Segment(0.4, s)], 2.0)
    assertEq(k.rowText(0), " ·  ")

@test("a gauge of no width draws nothing, and one is clipped to its rectangle")
gaugeTinyAndClipped()
    val s = Style.fg(Green)
    val g = Grid(6, 1)
    assertEq(g.gauge(2, 0, 0, [Segment(1.0, s)], 1.0), 2)
    assertEq(g.rowText(0), "      ")
    g.gauge(0, 0, 6, [Segment(1.0, s)], 1.0, clip = Rect(0, 0, 3, 1))
    assertEq(g.rowText(0), "[██   ")
    val h = Grid(4, 1)
    h.gauge(2, 0, 6, [Segment(1.0, s)], 1.0)
    assertEq(h.rowText(0), "  [█")

@test("a wide character for a segment or the rest is drawn one column wide")
gaugeWideChars()
    val g = Grid(6, 1)
    g.gauge(0, 0, 6, [Segment(1.0, Style.fg(Green), '日')], 2.0, rest = '本')
    assertEq(g.rowText(0), "[██··]")
