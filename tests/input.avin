module tests

// The input decoder over byte sequences: printable text, control keys, Escape and Alt, the cursor and
// function keys in their CSI and SS3 forms with modifiers, bracketed paste, SGR mouse reports, and
// every one of them split between two reads.
import dev.avinlang.tui as tui
import dev.avinlang.tui.{Alt, Ctrl, Decoder, Event, KeyPress, Mouse, MouseEvent, Paste, Shift}

import dev.avinlang.tui.{
  BackTab,
  Backspace,
  Char,
  Delete,
  Down,
  End,
  Enter,
  Escape,
  F,
  Home,
  Insert,
  Left,
  PageDown,
  PageUp,
  Right,
  Tab,
  Up
}

import dev.avinlang.tui.{Drag, Move, Press, Release, ScrollDown, ScrollLeft, ScrollRight, ScrollUp}

// Every event `text`'s bytes make, flushed at the end as after a pause.
events(text: string) -> Vector[Event]
  val d = Decoder()
  d.feedText(text)
  d.drain()

key(k: tui.Key, mods: int = 0) -> Event = KeyPress(k, mods)
ch(c: char, mods: int = 0) -> Event = KeyPress(Char(c), mods)

// The events of `text` fed in two pieces, cut after every byte in turn, with `next` asked after each
// piece and no flush until the end: what a sequence split between two reads gives.
splitEverywhere(text: string) -> Vector[Vector[Event]]
  val bytes = text.bytes
  val out = Vector.newBuilder[Vector[Event]]()
  for cut in 1 ..< bytes.length
    val d = Decoder()
    val got = Vector.newBuilder[Event]()
    d.feed(bytes.slice(0, cut).toArray())
    loop
      d.next() match
        Some(e) -> got.addOne(e)
        None -> break
    d.feed(bytes.slice(cut, bytes.length).toArray())
    for e in d.drain() do got.addOne(e)
    out.addOne(got.result())
  out.result()

@test("printable ASCII is a character key each")
printable()
  assertEq(events("aZ9 ~"), [ch('a'), ch('Z'), ch('9'), ch(' '), ch('~')])
  assertEq(events(""), [])

@test("UTF-8 of two, three and four bytes is one character key")
utf8()
  assertEq(events("é日😀"), [ch('é'), ch('日'), ch('😀')])

@test("bytes that are not UTF-8 are U+FFFD, one for each bad start and one for a broken sequence")
badUtf8()
  val d = Decoder()
  d.feed([byte(0xff), byte(0x80), byte(0xc3), byte(0x41), byte(0xc0), byte(0xaf), byte(0xed), byte(0xa0), byte(0x80)])
  val r = '\u{fffd}'
  assertEq(d.drain(), [ch(r), ch(r), ch(r), ch('A'), ch(r), ch(r), ch(r)])

@test("a character cut short and then flushed is U+FFFD")
truncatedUtf8()
  val d = Decoder()
  d.feed([byte(0xe6), byte(0x97)])
  assertEq(d.next(), None)
  assertEq(d.drain(), [ch('\u{fffd}')])

@test("control bytes are Ctrl and a letter, and Enter, Tab and Backspace are their own keys")
controlBytes()
  assertEq(events("\u{1}\u{3}\u{1a}"), [ch('a', Ctrl), ch('c', Ctrl), ch('z', Ctrl)])
  assertEq(events("\r\n\t\u{7f}"), [key(Enter), key(Enter), key(Tab), key(Backspace)])
  assertEq(events("\u{0}"), [ch(' ', Ctrl)])
  assertEq(events("\u{8}"), [ch('h', Ctrl)])
  assertEq(events("\u{1c}\u{1d}\u{1e}\u{1f}"), [ch('4', Ctrl), ch('5', Ctrl), ch('6', Ctrl), ch('7', Ctrl)])

@test("an escape alone is Escape only once nothing follows it")
loneEscape()
  val d = Decoder()
  d.feedText("\u{1b}")
  assertEq(d.next(), None)
  assertEq(d.hasPending(), true)
  assertEq(d.flush(), Some(key(Escape)))
  assertEq(d.hasPending(), false)
  assertEq(d.flush(), None)

@test("an escape before a key is that key with Alt")
altKeys()
  assertEq(events("\u{1b}x"), [ch('x', Alt)])
  assertEq(events("\u{1b}X"), [ch('X', Alt)])
  assertEq(events("\u{1b}é"), [ch('é', Alt)])
  assertEq(events("\u{1b}\u{1}"), [ch('a', Alt | Ctrl)])
  assertEq(events("\u{1b}\r"), [key(Enter, Alt)])
  assertEq(events("\u{1b}\u{7f}"), [key(Backspace, Alt)])

@test("two escapes are Alt-Escape, and an escape before a sequence is that sequence with Alt")
doubleEscape()
  assertEq(events("\u{1b}\u{1b}"), [key(Escape, Alt)])
  assertEq(events("\u{1b}\u{1b}x"), [key(Escape, Alt), ch('x')])
  assertEq(events("\u{1b}\u{1b}[A"), [key(Up, Alt)])
  assertEq(events("\u{1b}\u{1b}OP"), [key(F(1), Alt)])
  val d = Decoder()
  d.feedText("\u{1b}\u{1b}")
  assertEq(d.next(), None)

@test("escape and a bracket, with nothing after, is Alt and the bracket")
altBracket()
  assertEq(events("\u{1b}["), [ch('[', Alt)])
  assertEq(events("\u{1b}O"), [ch('O', Alt)])

@test("a sequence cut short and flushed is Escape and the keys of its bytes")
cutShort()
  assertEq(events("\u{1b}[1;"), [key(Escape), ch('['), ch('1'), ch(';')])
  val d = Decoder()
  d.feed([byte(0x1b), byte(0xe6)])
  assertEq(d.next(), None)
  assertEq(d.drain(), [key(Escape), ch('\u{fffd}')])

@test("the arrows, Home and End, in CSI and SS3 forms")
arrows()
  assertEq(
    events("\u{1b}[A\u{1b}[B\u{1b}[C\u{1b}[D\u{1b}[H\u{1b}[F"),
    [key(Up), key(Down), key(Right), key(Left), key(Home), key(End)]
  )
  assertEq(
    events("\u{1b}OA\u{1b}OB\u{1b}OC\u{1b}OD\u{1b}OH\u{1b}OF"),
    [key(Up), key(Down), key(Right), key(Left), key(Home), key(End)]
  )

@test("modifiers ride in the second parameter, one more than their bits")
modified()
  assertEq(events("\u{1b}[1;2A"), [key(Up, Shift)])
  assertEq(events("\u{1b}[1;3B"), [key(Down, Alt)])
  assertEq(events("\u{1b}[1;5C"), [key(Right, Ctrl)])
  assertEq(events("\u{1b}[1;8D"), [key(Left, Shift | Alt | Ctrl)])
  assertEq(events("\u{1b}[3;5~"), [key(Delete, Ctrl)])
  assertEq(events("\u{1b}[1;1A"), [key(Up)])
  assertEq(events("\u{1b}[1;0A"), [key(Up)])

@test("the editing keys of the `~` form, both Home and End numberings")
tildeKeys()
  assertEq(
    events("\u{1b}[1~\u{1b}[2~\u{1b}[3~\u{1b}[4~\u{1b}[5~\u{1b}[6~\u{1b}[7~\u{1b}[8~"),
    [key(Home), key(Insert), key(Delete), key(End), key(PageUp), key(PageDown), key(Home), key(End)]
  )

@test("F1 to F12 in every form terminals send them")
functionKeys()
  assertEq(events("\u{1b}OP\u{1b}OQ\u{1b}OR\u{1b}OS"), [key(F(1)), key(F(2)), key(F(3)), key(F(4))])
  assertEq(
    events("\u{1b}[11~\u{1b}[12~\u{1b}[13~\u{1b}[14~\u{1b}[15~"),
    [key(F(1)), key(F(2)), key(F(3)), key(F(4)), key(F(5))]
  )
  assertEq(
    events("\u{1b}[17~\u{1b}[18~\u{1b}[19~\u{1b}[20~\u{1b}[21~\u{1b}[23~\u{1b}[24~"),
    [key(F(6)), key(F(7)), key(F(8)), key(F(9)), key(F(10)), key(F(11)), key(F(12))]
  )
  assertEq(events("\u{1b}[1;2P"), [key(F(1), Shift)])
  assertEq(events("\u{1b}[15;5~"), [key(F(5), Ctrl)])

@test("Shift-Tab is BackTab with Shift")
backTab()
  assertEq(events("\u{1b}[Z"), [key(BackTab, Shift)])

@test("sequences the decoder does not know are dropped, and what follows them is read")
unknown()
  assertEq(events("\u{1b}[99~a"), [ch('a')])
  assertEq(events("\u{1b}[Ix\u{1b}[O"), [ch('x')])
  assertEq(events("\u{1b}Ozb"), [ch('b')])
  assertEq(events("\u{1b}[?1;2cq"), [ch('q')])
  assertEq(events("\u{1b}[1;2;3;4;5;6;7;8;9;99999999999999999999Ab"), [key(Up, Shift), ch('b')])

@test("a bracketed paste is one event, its text kept whole, escapes and new lines included")
paste()
  assertEq(events("\u{1b}[200~hello\nworld\u{1b}[201~"), [Paste("hello\nworld")])
  assertEq(events("\u{1b}[200~\u{1b}[201~"), [Paste("")])
  assertEq(events("\u{1b}[200~a\u{1b}[Ab\u{1b}[201~x"), [Paste("a\u{1b}[Ab"), ch('x')])
  assertEq(events("\u{1b}[200~日本\u{1b}[201~"), [Paste("日本")])
  assertEq(events("q\u{1b}[200~\u{3}\u{1b}[201~"), [ch('q'), Paste("\u{3}")])

@test("a paste in progress waits through a flush for its end")
pasteWaits()
  val d = Decoder()
  d.feedText("\u{1b}[200~abc")
  assertEq(d.next(), None)
  assertEq(d.flush(), None)
  assertEq(d.hasPending(), true)
  d.feedText("def\u{1b}[20")
  assertEq(d.flush(), None)
  d.feedText("1~")
  assertEq(d.next(), Some(Paste("abcdef")))
  assertEq(d.hasPending(), false)

@test("a large paste arrives whole")
largePaste()
  val body = "0123456789".repeat(10000)
  assertEq(events("\u{1b}[200~" + body + "\u{1b}[201~"), [Paste(body)])

mouse(action: tui.MouseAction, button: int, x: int, y: int, mods: int = 0) -> Event =
  Mouse(MouseEvent(action, button, x, y, mods))

@test("SGR mouse: presses and releases of each button, counted from 0")
mouseClicks()
  assertEq(events("\u{1b}[<0;1;1M"), [mouse(Press, 0, 0, 0)])
  assertEq(events("\u{1b}[<0;10;5m"), [mouse(Release, 0, 9, 4)])
  assertEq(events("\u{1b}[<1;3;4M"), [mouse(Press, 1, 2, 3)])
  assertEq(events("\u{1b}[<2;300;200M"), [mouse(Press, 2, 299, 199)])

@test("SGR mouse: the wheel in four directions")
mouseWheel()
  assertEq(events("\u{1b}[<64;5;5M"), [mouse(ScrollUp, -1, 4, 4)])
  assertEq(events("\u{1b}[<65;5;5M"), [mouse(ScrollDown, -1, 4, 4)])
  assertEq(events("\u{1b}[<66;5;5M"), [mouse(ScrollLeft, -1, 4, 4)])
  assertEq(events("\u{1b}[<67;5;5M"), [mouse(ScrollRight, -1, 4, 4)])

@test("SGR mouse: a drag with a button held, a move with none, and the modifiers")
mouseDrag()
  assertEq(events("\u{1b}[<32;7;8M"), [mouse(Drag, 0, 6, 7)])
  assertEq(events("\u{1b}[<34;7;8M"), [mouse(Drag, 2, 6, 7)])
  assertEq(events("\u{1b}[<35;7;8M"), [mouse(Move, -1, 6, 7)])
  assertEq(events("\u{1b}[<4;1;1M"), [mouse(Press, 0, 0, 0, Shift)])
  assertEq(events("\u{1b}[<8;1;1M"), [mouse(Press, 0, 0, 0, Alt)])
  assertEq(events("\u{1b}[<16;1;1M"), [mouse(Press, 0, 0, 0, Ctrl)])
  assertEq(events("\u{1b}[<80;1;1M"), [mouse(ScrollUp, -1, 0, 0, Ctrl)])

@test("malformed mouse reports are dropped")
mouseMalformed()
  assertEq(events("\u{1b}[<0;1M"), [])
  assertEq(events("\u{1b}[<0;0;1M"), [])
  assertEq(events("\u{1b}[<0;1;1;1M"), [])
  assertEq(events("\u{1b}[<0;1;1Ha"), [ch('a')])

@test("every sequence split between two reads at every byte decodes as it does whole")
splits()
  val samples = [
    "\u{1b}[1;5C",
    "\u{1b}OP",
    "\u{1b}[<64;12;34M",
    "\u{1b}[200~pa\u{1b}ste\u{1b}[201~",
    "日😀",
    "\u{1b}[15;2~",
    "a\u{1b}[Bb",
    "\u{1b}\u{1b}[A",
    "\u{1b}日",
    "\u{1b}[<35;1;2m"
  ]
  for s in samples
    val whole = events(s)
    for got in splitEverywhere(s)
      assertEq(got, whole)

@test("keys typed together in one read come out in order")
burst()
  assertEq(
    events("ab\u{1b}[Ac\u{1b}OPd\u{1b}x"),
    [ch('a'), ch('b'), key(Up), ch('c'), key(F(1)), ch('d'), ch('x', Alt)]
  )

@test("next leaves a sequence still arriving where it is, and flush does not touch a complete one")
nextAndFlush()
  val d = Decoder()
  d.feedText("\u{1b}[1;5")
  assertEq(d.next(), None)
  d.feedText("A")
  assertEq(d.flush(), Some(key(Up, Ctrl)))
  assertEq(d.next(), None)
