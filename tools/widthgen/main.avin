// Writes `dev/avinlang/tui/width_table.avin`, the ranges of characters `dev.avinlang.tui`'s width rules
// read, from three files of the Unicode Character Database:
//
//     avin run tools/widthgen -- <dir holding the files> dev/avinlang/tui/width_table.avin
//
// The directory holds `DerivedGeneralCategory.txt`, `EastAsianWidth.txt` and `emoji-data.txt`, all of
// one Unicode version, which the table records.
import avin.fs
import avin.process

// A run of code points, both ends included.
data Span(first: int, last: int)

main(args: Vector[string]) -> int
  if args.length != 2
    eprintln("usage: widthgen <unicode data directory> <output file>")
    return 2
  val dir = args(0)
  val categories = readFile(dir + "/DerivedGeneralCategory.txt")
  val eastAsian = readFile(dir + "/EastAsianWidth.txt")
  val emoji = readFile(dir + "/emoji-data.txt")

  val version = versionOf(eastAsian)
  if versionOf(categories) != version
    eprintln(s"DerivedGeneralCategory.txt is Unicode ${versionOf(categories)} and EastAsianWidth.txt $version")
    return 1

  // Zero width: nonspacing and enclosing marks, format characters but the soft hyphen and the marks
  // that are written before a number and shown, and the Hangul vowels and finals that join the
  // syllable before them.
  val zero = Buffer[Span]()
  for s in spans(categories, f -> f == "Mn" || f == "Me" || f == "Cf")
    zero.append(s)
  zero.append(Span(0x1160, 0x11ff))
  zero.append(Span(0xd7b0, 0xd7ff))
  val shown = [
    Span(0xad, 0xad),
    Span(0x600, 0x605),
    Span(0x6dd, 0x6dd),
    Span(0x70f, 0x70f),
    Span(0x890, 0x891),
    Span(0x8e2, 0x8e2),
    Span(0x110bd, 0x110bd),
    Span(0x110cd, 0x110cd)
  ]

  // Two columns: East Asian Wide and Fullwidth.
  val wide = spans(eastAsian, f -> f == "W" || f == "F")

  // Characters that a variation selector 16 asks to show as an emoji, beyond ASCII.
  val pictures = spans(emoji, f -> f == "Emoji").filter(s -> s.first >= 0x80)

  val out = StringWriter()
  out.write("module dev.avinlang.tui\n\n")
  out.write(s"// Generated by tools/widthgen from the Unicode Character Database $version. Do not edit.\n\n")
  out.write(s"// The Unicode version the tables below are read from.\n")
  out.write(s"val unicodeVersion: string = \"$version\"\n\n")
  table(out, "zeroWidthRanges", "Characters that take no column of their own.", minus(merged(zero), shown))
  table(out, "wideRanges", "Characters that take two columns: East Asian Wide and Fullwidth.", merged(wide))
  table(out, "emojiRanges", "Characters beyond ASCII with the Emoji property.", merged(pictures))
  fs.writeText(args(1), out.text) match
    Ok(_) ->
      println(s"wrote ${args(1)} from Unicode $version")
      0
    Err(e) ->
      eprintln(s"${args(1)}: ${e.message}")
      1

private readFile(file: string) -> string = fs.readText(file) match
  Ok(text) -> text
  Err(e) ->
    eprintln(s"$file: ${e.message}")
    process.exit(1)

// The version a data file's first line names: `# EastAsianWidth-16.0.0.txt` is `16.0.0`.
private versionOf(text: string) -> string
  val first = text.lines(0)
  val dash = first.lastIndexOf("-")
  val dot = first.lastIndexOf(".txt")
  if dash < 0 || dot < dash then "unknown" else first.slice(dash + 1, dot)

// The spans of every data line whose second field `keep` accepts.
private spans(text: string, keep: (string) -> bool) -> Vector[Span]
  val found = Buffer[Span]()
  for raw in text.lines
    val hash = raw.indexOf("#")
    val line = (if hash >= 0 then raw.slice(0, hash) else raw).trim
    if line.isEmpty then continue
    val fields = line.split(";")
    if fields.length < 2 || !keep(fields(1).trim) then continue
    val points = fields(0).trim
    val dots = points.indexOf("..")
    if dots < 0
      val p = hex(points)
      found.append(Span(p, p))
    else
      found.append(Span(hex(points.slice(0, dots)), hex(points.slice(dots + 2, points.byteLength))))
  found.toVector

private hex(digits: string) -> int
  var n = 0
  for c in digits.chars
    val d = c.asDigit
    if !(0 <= d < 16) then fail(s"not a hexadecimal code point: $digits")
    n = n * 16 + d
  n

// The spans sorted, with overlapping and adjacent ones joined.
private merged(spans: Iterable[Span]) -> Vector[Span]
  val sorted = Buffer[Span]()
  sorted.appendAll(spans)
  sorted.sortInPlaceWith((a, b) -> a.first - b.first)
  val out = Buffer[Span]()
  for s in sorted
    if out.nonEmpty && s.first <= out(out.length - 1).last + 1
      val top = out(out.length - 1)
      if s.last > top.last then out(out.length - 1) = Span(top.first, s.last)
    else
      out.append(s)
  out.toVector

// The code points of `spans` that no span of `holes` holds.
private minus(spans: Vector[Span], holes: Vector[Span]) -> Vector[Span]
  val out = Buffer[Span]()
  for s in spans
    var from = s.first
    for h in holes
      if h.last < from || h.first > s.last then continue
      if h.first > from then out.append(Span(from, h.first - 1))
      from = h.last + 1
    if from <= s.last then out.append(Span(from, s.last))
  out.toVector

// Writes `spans` as a flat array of first and last code points, eight spans to a line.
private table(out: StringWriter, name: string, doc: string, spans: Vector[Span])
  out.write(s"// $doc Pairs of first and last code points, sorted.\n")
  out.write(s"private val $name: Array[int] = [\n")
  var i = 0
  for s in spans
    if i % 8 == 0 then out.write("    ")
    out.write(s"0x${hexText(s.first)}, 0x${hexText(s.last)}")
    i += 1
    if i < spans.length then out.write(if i % 8 == 0 then ",\n" else ", ")
  out.write("\n]\n\n")

private hexText(n: int) -> string
  val digits = "0123456789abcdef"
  if n < 16 then return digits.slice(n, n + 1)
  hexText(n / 16) + digits.slice(n % 16, n % 16 + 1)
